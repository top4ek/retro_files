MACLIB MATH
MACLIB GRAPH
MACLIB GAME2P
BLANK EQU 100H-4H ;נץףפן
ORG 100H
SAVE4CPM
CALL MAIN
QUIT2CPM
RST07
CHAR16
MAIN:
	TURBOCLS
	MVI A,0A0H
	STA WPLANE+1;קכל.3-א נלןדכ.הלס קשקןהב 16ָ16
	MVI L,15
	MVI H,15 ;כןןעהימפש קשקןהיםןחן פבמכב
MAIN0:
	MVI A,1FH
	ANA L
	MOV L,A
	MVI A,1FH
	ANA H
	MOV H,A
	XRA A;כןה T-34
	CALL PUT16x16
	LPAUSE
	WAITKEY
	PUSH PSW ;תבנןםמים כןה מבצבפיס
	MVI A,BLANK
	CALL PUT16x16 ;ףןפעום כבםומר
	POP PSW
	CPI AR2
	JZ MAIN2;נעןהןלצים פוףפ 16ָ6
	CPI LEFT
	JNZ MN1
	DCR H
	JMP MAIN0
MN1:	CPI RIGHT
	JNZ MN2
	INR H	;ץקולי‏ים כןןעה.ט וףלי מבצבפב ףפעולכב
		;קנעבקן
	JMP MAIN0
MN2:	CPI DOWN
	JNZ MN3
	INR L
	JMP MAIN0
MN3:	CPI UP
	JNZ MAIN0
	DCR L
	JMP MAIN0
MAIN2:
	TURBOCLS
	LXI H,3
	XRA A
	MOV B,A
	MVI C,8*8/8
MN4:	MOV A,B
	CALL PUT16x16
	ADI 4
	MOV B,A
	INR H
	INR H
	INR H
	INR H
	MVI A,1FH
	ANA H
	JNZ MN4
	MOV H,A ;H=0
	INR L
	INR L
	INR L
	DCR C
	JNZ MN4
	LPAUSE
	WAITKEY
	RET ;קשטןה ק דנ/ם

;נןהכלא‏בום גיגליןפוכי
MACLIB APINIT
MACLIB MATH
MACLIB GRAPH
MACLIB GAME2P
MACLIB BITMAP
MACLIB SOUND

BLANK EQU 84 ;נץףפן

ORG 100H
SAVE4CPM
CALL MAIN
QUIT2CPM
RST07 ;בננבעבפמשו נעועשקבמיס
CHAR
POINT
POINTCHAR ;קשקןה פן‏ו‏מןחן ףיםקןלב
CHAR16 ;קשקןה גןלרûןחן ףיםקןלב
GETPUT ;GET&PUT
MULTIDIV
BUFFER	EQU 34FAH ;מב‏בלן נבםספי הלס GET'a!
IM2:	DS 2 ;בהעוף 2 ףנעבךפב
IM3:	DS 2 ;בהעוף 3  ףנעבךפב

MAIN:
	TURBOCLS
	MVI A,0C0H ;הלס II-ןך נלןףכןףפי
	STA WPLANE+1
	XRA A
	LXI H,0
	CALL PUT16x16 ;קשקןהים כבםומר
	INR H
	INR H
	MVI A,28
	CALL PUT16x16
	INR H
	INR H
	MVI A,72
	CALL PUT16x16
	LPAUSE
	TINKLE
	CALL OUTINFO
	DB 7,17H,13,13,6,2,' PRESS ANY KEY!!'
	DB 0
	WAITKEY
;
;פונוער תבנןםמים 3 עיףץמכב ף נןםן‎רא GET!
	LXI H,0
	LXI D,BUFFER ;בהעוף 1-חן ףנעבךפב
	LXI B,1010H ;עבתםוע כבעפימכי
	CALL GET ;קןתרםום
	XCHG
	SHLD IM2 ;בהעוד 2-חן ףנעבךפב
	XCHG
	LXI H,1000H ;
	CALL GET
	XCHG
	SHLD IM3 ;בהעוף 3-וחן ףנעבךפב
	XCHG
	LXI H,2000H
	CALL GET
	BELL ;ףיחמבליתיעץום ןכןמ‏במיו
;יפבכ, תבנןםמילי פעי ףנעבךפב
;פונוער יט םןצמן קשקןהיפר PUT'om ילי PUTRESIZE'om!
	LPAUSE
;
	LXI H,8080H ;דומפע üכעבמב?
	LXI D,BUFFER
	LXI B,1825H ;מןקבס קשףןפב י ûיעימב(B,C RESP.)
	CALL PUTRESIZE
	LHLD IM2
	XCHG
	LXI H,1090H
	LXI B,200AH ;DY*2,DX-5
	CALL PUTRESIZE
;י נןףלוהמיך ףנעבךפ ףןצםום ‏ץפןכ
	LHLD IM3 ;בהעוף 3-וחן ףנעבךפב
	XCHG ;ק DE
	LXI H,8010H ;ק קועטמוך נעבקןך  ‏בףפי üכעבמב
	LXI B,80CH
	CALL PUTRESIZE ;קשקןה
	BELL
	BELL
	BELL ;3 תקןמכבן נןגוהו עבתץםב מבה נלןפרא!
