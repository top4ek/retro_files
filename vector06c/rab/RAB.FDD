SHLD NMM
CHM1:INX H
DCR B
JNZ CHM1
CALL PL1CHAN
INX H
CALL PL2CHAN
INX H
CALL PL3CHAN
MVI A,1
STA YMUSIC
RET




EXIT:DI
CALL TURBO
LXI H,6000H
LXI D,0E000H
LXI B,2000H
CALL PEREN
LHLD OLD39H
