	LXI H,WAVE1
	DCR M
	LHLD ABSNOTE1
	INR H
	MOV A,L
	SUI 8
	MOV L,A
	SHLD ABSNOTE1
	JMP P1C7 ;ןףפבלרמןו תב מבף ףהולבופ ןףמןקמןך
