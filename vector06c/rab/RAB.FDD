LDA 8000H
ORA A
JZ FRSTMEL ; נועקבס םולןהיס
XRA A
STA 8000H
JMP SCNDMEL  ;מב קפעןץא םולןהיא
FRSTMEL:ADI 1
STA 8000H
LXI B,H81C2
JMP KAR0
SCNDMEL:LXI B,H8146

KAR0:DI
XRA  A
STA DYNAM
CALL MAIN
EI
JMP 0

MAIN: ;ןףמןקמןך דיכל
IN 1
RLC;IF RUS PRESSED
RNC;RETURN TO FUCKIN'OS!
LDAX B
INR A
RZ
INR A
JNZ KAR1
XRA A
STA H8117
STA H8118
INX B
JMP MAIN
KAR1:INR A
JNZ KAR2
MVI A,1EH ;ִֻֿ'MVI E,'
STA H8117
INX B
LDAX B
STA H8118
INX B
JMP MAIN
KAR2:SUI 3
STA LENGTH
INX B
LDAX B
STA HFA
STA HFB
STA HF9
INX B
LDAX B
STA HFC
MOV D,A
MOV E,A

NOTE:LDA TEMP
STA xTEMP
MAINC:MVI A,255
STA REPEAT ; Þֹcּֿ ׀ֿװֿֿׂ׳ ־ֿװÙ

CYCLE:DCR D
JNZ KAR4
LXI H,HFA
DCR M
JNZ KAR4
LDA HF9
ORA A
JM KAR3
LDA DYNAM
XRI 1
STA DYNAM
OUT 1
KAR3:LXI H,HFC
MOV D,M
LDA HF9
STA HFA

H8117:NOP ; OR MVI E,BYTE
H8118:NOP

KAR4:DCR E
JNZ KAR5
LXI H,HFB
DCR M
JNZ KAR4
LDA HF9
ORA A
JM KAR40
LDA DYNAM
XRI 1
STA DYNAM
OUT 1
KAR40:LXI  H,HFC
MOV E,M
LDA  HF9
STA HFB
DCR E

KAR5:LXI H,REPEAT
DCR M
JNZ CYCLE
LXI H,xTEMP
DCR M
JNZ MAINC
LXI H,LENGTH
DCR M
JNZ NOTE
INX B
JMP MAIN ; מב ףלוהץא‎ץא מןפכץ

;/////// ֱֲֿׂÞֵֹ  ס‏וךכי ///////
DYNAM:DB 0
LENGTH:DB 0
TEMP:DB 5
REPEAT:DB 0
xTEMP:DB 0
HF9:DB 0
HFA:DB 0
HFB:DB 0
HFC:DB 0

MELODY1:
H81C2:
DB 6,1,0A8H,10,255,0,3,1,0C7H,1,-1,0
DB 4,1,0A8H,8,-1,0,12,1,07EH,8,-1,-1
DB 4,1,63H,1,-1,-1,4,1,63H,1,-1,0
DB 4,1,63H,4,-1,-1,4,1,7EH,4,-1,-1
DB 4,1,63H,8,-1,-1,12,1,53H,12,-1,-1
DB 4,1,3EH,4,-1,-1,28H,1,3EH
DB -1  ; end of karateka1

MELODY2:
H8146:
DB 6,1,0FBH,4,1,0A8H,4,1,7EH,28H,1,63H
DB 6,2,4FH,4,1,0BCH,4,1,0A8H,4,1,85H
DB 1EH,1,70H,6,2,2AH,4,1,0C7H,4,1,96H
DB 10,1,7EH,6,2,90H,4,1,0BCH,4,1,7EH
DB 4,1,70H,46H,1,49H
;-------//[05-C0-FE] DATA SYSTEM-------;
DB 6,2,4FH,4,1,0E0H,4,1,0A8H,4,1,7EH
DB 4,1,70H,28H,1,53H,6,2,4FH,4,1,0BCH
DB 4,1,0A8H,4,1,96H,4,1,85H,4,1,70H
DB 28H,1,53H,6,1,0FBH,4,1,0A8H,4,1,7EH
DB 5,1,70H,5,1,63H,6,1,53H,6,1,49H
DB 50H,1,3EH
DB -1

