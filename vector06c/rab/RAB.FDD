;FALSE	EQU 0
;TRUE	EQU -1
;DSEG

;	2KOI8.SID
;עבגןפבופ ק ףיהו, חעץתיפףס כןםבמהןך
;		I2KOI8.SID
;		R8000
;עבףנןלבחבופףס ף בהעוףב 8100

; ק כןי-8 נועוהולשקבופ ףיםקןלש
;קטןה:	BC-מב‏.בהעוף ףפעןכ
;	Dו-כןמו‏משך בהעוף ףפעןכ
;מבנעיםוע:	C8100,.STR1,.ESTR
; ילי		C8100,234,2A5
; ילי		XB
;		.STR1 (בהעוף מב‏בלב ףפעןכ(י)
;		XD
;		.ESTR (בהעוף  כןמדב ףפעןכ(י)
;		C8100 ;תבנץףכבום  CALL'om 2KOI8
;CSEG
	ORG 8100H
;נעןגץא ףןתהבפר םןהץלר
KOI0:	LDAX B
	CPI 64
	JC KOI1
	ADI 128 ;2KOI8!
	STAX B
KOI1:	MOV A,B
	CMP D
	JNZ KOI2
	MOV A,C ;DE=BC?
	CMP E
	RZ      ;הב - קשטןה  ק SID
KOI2:	INX B
	JMP KOI0;ימב‏ו נעןהןלצבום  ף מןקשם בהעוףןם

	END
INCLUDE MATH.LIB
; נעןחעAםםב ננעוןגעבתןקבמיס כןהןק ק
; פוכףפ ף  DB
	LXI SP,09DFFH
	LDA 80H
	DCR A
	JM @NOFILE	; מו תבהבמב ףפעןכב נבעבםופעןק
	XRA A
	STA 68H		; EXTENT = 0
	STA 7CH		; CR     = 0
	LXI D,5CH
	MVI C,15	; OPEN FUNC
	CALL 5
	CPI  255
	JZ @OPENERR	; ןûיגכב נעי ןפכעשפיי
	LXI H,AREA
	MVI D,1
NEXTSTR:
;	מב‏בלן ףפעןכי
	MVI C,48	; ף‏ופ‏יכ Cיםןלןק ק ףפעןכו
	MVI  M,13
	INX H
	MVI M,10
	INX H
	MVI M,9
	INX H
	MVI M,'D'
	INX H
	MVI M,'B'
	INX H
	MVI M,32
	INX H
	MVI M,39	; בנןףפעןז
	INX H
NEXTCODE:
	MOV A,D
	DCR A		; וףלי DE = 100H,
	CZ RBLOCK	; פן ‏יפבום ףלוה.גלןכ
	LDAX D
	INX D
	MOV M,A
	INX H
	CPI 'R'
	JZ ENDCH	; כןמוד כבבמבלב
	CPI '$'
	JZ ENDCH	; כןמוד כבמבלב
	DCR C
	JNZ NEXTCODE	; נועוניףשקבום  ו‎ו 47 גבךפ
ENDCH:	MVI M,39	; תבכעשבום כבקש‏כץ
	INX H
	JMP NEXTSTR	; דיכליםףס

@NOFILE:
	CALL @NOF1	; קשקןה ףפעןכי ף נעוהץנעוצהומיום
	DB 'NO FILE NAME ERROR.$'
@NOF1:	POP D
	MVI C,9
	CALL 5
	RST 0		; קשטןה ק ןףר
@OPENERR:
	CALL @NOF1
	DB 'OPEN FILE ERROR.$'

RBLOCK:
;	נןהחעץתכב גלןכב/ נעןקועכב ןכןמ‏במיס זבךלב הבממשט
	PUSH H
	PUSH B
	LXI D,5CH
	MVI C,14H	; READ FUNC
	CALL  5
	POP B
	POP H
	LXI D,80H	; ץכבתבפולר מב ןגלבףפר DMA
	ORA A
	RZ		; וףלי ‏פומיו גשלן, פן קףו
	POP PSW		; ‏יףפכב ףפוכב
	DCX H
	MVI A,39
	CMP M		; כבקש‏כב גשלב תבהבמב?
	INX H
	JZ NOCAV	; וףלי ב, פן מו ףפבקים ו‎ו
	MVI M,39
	INX H
NOCAV:
	PUSH H		; בהעוף כןמדב הבממשט
	LXI D,5CH
	MVI C,10H	; CLOSE SOURCE FILE
	CALL 5
;	םומסום עבףûיעומיו עבגן‏וחן זבךלב
	LXI H,65H
	MVI M,'T'
	INX H
	MVI M,'X'
	INX H
	MVI M,'T'
	
	LXI D,5CH
	MVI C,16H	; CREATE FUNC
	CALL 5
	CPI 255
	JNZ SAVD1	; ןנועבדיס ץהבלבףר - מב SAVD1
	CALL @NOF1
	DB 'COULD NOT CREATE A .TXT FILE.$'

SAVD1:	LXI H,AREA	; מב‏בלן נעיוםמיכב
	XRA A
	STA 68H		; EXTENT = 0
	STA 7CH		; CR = 0
SAVD2:
	LDIR ,80H,80H	;ניûום ק ןגלבףפר DMA
	PUSH H
	LXI D,5CH
	MVI C,15H	; WRITE FUNC
	CALL 5
	ORA A
	JNZ @WERR	; ןûיגכב תבניףי
	POP H		; פוכ.בהעוף הבממשט
	POP D		; בהעוף כןמדב
	PUSH D
	CMPHD		; HL < DE ?
	JC SAVD2	; וףלי הב, פן נעןהןלצבום ניףבפר
	LXI D,5CH
	MVI C,10H	; CLOSE FUNC
	CALL 5
	CALL @NOF1
	DB 'JOB IS DONE! CONGRATULATIONS!!!$'
@WERR:	DB 'SORRY. WRITE FILE ERROR.  O(    $'

AREA:	DB 0	; קףס ןףפבלרמבס ןגלבףפר נבםספי
		; ןפקןהיפףס נןה נעיוםמיכ

	END


