MACLIB MATH
MACLIB GRAPH
MACLIB GAME2P
BLANK EQU 84
ORG 100H
SAVE4CPM
CALL MAIN
QUIT2CPM
RST07
CHAR
CHAR16
MAIN:
	TURBOCLS
	CALL OUTINFO
	DB 6,2,'NOW YOU MUST GET IT!'
	DB 0
	MVI A,0A0H
	STA WPLANE+1;קכל.3-א נלןדכ.הלס קשקןהב 16ָ16
	MVI L,15
	MVI H,15 ;כןןעהימפש קשקןהיםןחן כבםמס
;ית נעןחעבםםש DOWN2EARTH
MAIN0:
	MVI A,1FH
	ANA L
	MOV L,A
	MVI A,1FH
	ANA H
	MOV H,A
	XRA A;כןה כבםמס
	CALL PUT16x16
	LPAUSE
	WAITKEY
	PUSH PSW ;תבנןםמים כןה מבצבפיס
	MVI A,BLANK
	CALL PUT16x16 ;ףןפעום כבםומר
	POP PSW
	CPI AR2
	JZ MAIN2;נעןהןלצים פוףפ 16ָ6
	CPI LEFT
	JNZ MN1
	DCR H
	JMP MAIN0
MN1:	CPI RIGHT
	JNZ MN2
	INR H	;ץקולי‏ים כןןעה.ט וףלי מבצבפב ףפעולכב
		;קנעבקן
	JMP MAIN0
MN2:	CPI DOWN
	JNZ MN3
	INR L
	JMP MAIN0
MN3:	CPI UP
	JNZ MAIN0
	DCR L
	JMP MAIN0
MAIN2:	LXI H,3
	XRA A
	MOV B,A
MN4:	MOV A,B
	CALL PUT16x16
	ADI 4
	MOV B,A
	INR H
	INR H
	INR H
	INR H
	MVI A,1FH
	ANA H
	JNZ MN4
	MOV H,A ;H=0
	INR L
	INR L
	MOV A,L
	CPI 1AH
	JC MN4
	LPAUSE
	WAITKEY
	RET ;קשטןה ק דנ/ם

