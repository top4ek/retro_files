ORG 100H
LXI SP,8000H
CALL BOARD
CALL INIT
CALL DESIGN
CALL FLOAD
CALL CLW
CALL GET
CALL DISPATCHER
CALL EXITTER
JMP 0

POPA MACRO
     POP H
     POP D
     POP B
     ENDM
PUSHA MACRO
      PUSH B
      PUSH D
      PUSH H
      ENDM
EXITTER:
DI
LHLD OLD39H
SHLD 39H
MVI A,23H
OUT 10H
EI
RET

LDIR:
	PUSH PSW
	MOV A,M
	STAX D
	INX H
	INX D
	DCX B
	MOV A,B
	ORA C
	JNZ LDIR+1
	POP PSW
RET

XDIR:
PUSH PSW
 MOV A,M
 PUSH PSW
  LDAX D
  MOV M,A
 POP PSW
 STAX D
 INX H

 INX D
 DCX B
 MOV A,B
 ORA C
 JNZ XDIR+1
POP PSW
RET

ADDHL:ADD L
MOV L,A
RNC
INR H
RET

; ////////// קשקןה מב üכעבמ ///////////
PLOT:
PUSHA
MVI A,7
ANA H
LXI D,NumBit
ADD E
MOV E,A
JNC $+4
INR D
MOV A,H
RRC
RRC
RRC
ANI 1FH

ORI 80H
MOV H,A
MOV A,L
CMA
MOV L,A
LXI B,2000H
LDAX D
MOV D,A
NOP
ORA M
NOP
REPT 2
	DAD B
	MOV A,D
	NOP
	ORA M
        MOV M,A
	ENDM
DAD B
MOV A,D
NOP
WHCOL:ORA M
NOP
POPA
RET

NumBit:DB 80H,40H,20H,10H,8,4,2,1

SETCOL: ;ץףפבמןקכב דקופב הלס ףגש PLOT
PUSH D
PUSH H
PUSH PSW
MVI D,3
LXI H,WHCOL
SETC0:
	RRC
	JNC SETC1
	MVI M,0B6H
	DCX H
	MVI M,0
	JMP SETC2
SETC1:  MVI M,0A6H
	DCX H
	MVI M,2FH  ; 'CMA'
SETC2:  
REPT 4
	DCX H
	ENDM
DCR D
JP SETC0
POP PSW
POP H
POP D
RET

;/// קשקןה לימיי, VHLine //
VHLINE:PUSHA
LXI B,0
MOV A,H
CMP D
JZ $+10
MVI B,1
JC $+5
MVI B,-1
MOV A,L
CMP E
JZ $+10
MVI C,1
JC $+5
MVI C,-1
VHL0:CALL CMPHD
JZ VHL1
CALL PLOT
MOV A,H
ADD B
MOV H,A
MOV A,L
ADD C
MOV L,A
JMP VHL0
VHL1:POPA
RET
CMPHD:MOV A,H
CMP D
RNZ
MOV A,L
CMP E
RET
;////  תקץכ-2, כבכ ׳ בחבפו ?? //////////////////
;//////////  B E L L ///////////////
BELL:DI
MVI H,0
MVI C,0C0H
BELL1: MVI A,0CH
CALL WAIT
MOV A,H
XRI 1
MOV H,A
OUT 1
DCR C
JNZ BELL1
EI
RET
WAIT: ; Úֱִֵׂײֱֻ, ׳ ב-Þֹ׃ּֿ Úֱִֵׂײֹֻ
STC
PUSH PSW
SBI 1
JNZ $-2
POP PSW
SBI 1
JNZ WAIT+1
RET

;///// קשקןה ףיםקןלב מב üכעבמק 4-ט נלןףכןףפסט //////
PUTUCHAR:

PUSHA
PUSH PSW
XCHG
MOV L,A
MVI H,0
DAD H
DAD H
DAD H
ADDRTBL:LXI B,1800H
DAD B
XCHG
MVI A,80H
ORA H
MOV H,A
MOV A,L
ADD A
ADD A
ADD A
CMA
MOV L,A
MVI B,8
;
PUC1:LDA HEIGHT
MOV C,A  ;//////׳Ù׃ֿװֱ ׃ֹֽ׳ֱּֿ//////
PUC2:
  LDAX D
  NOP
 ; MOV M,A
  NOP
MVI A,20H
  ADD H
  MOV H,A
LDAX D
NOP
MOV M,A
MVI A,20H
ADD H
MOV H,A
LDAX D
NOP
MOV M,A
MVI A,20H
ADD H
MOV H,A
LDAX D
PCOL1:NOP ; ןגעבגןפכב (nop,xra a,cma)
;mov m,a
NOP
MVI A,0A0H
ADD H
MOV H,A
DCR L
DCR C

JNZ PUC2
INX D
DCR B
JNZ PUC1
POP PSW
POPA
RET
;/////// ױ׃װֱ־ֿ׳ֱֻ ֳ׳ֵװֱ ִּׁ ׃ֹֽ׳ּֿֿ׳,׳Ù׳ִֹֽֿÙָ PUTUCHAR ///
;
CHARCOLOR:
PUSH B
PUSH H
MOV B,A
MVI C,0
ANI 10H
JZ $+5
MVI C,2FH   ;'CMA'
MOV A,B
MVI B,3
LXI H,PCOL1
CHC1:RRC
MOV M,C
JC $+5
MVI M,0AFH
REPT 7
	DCX H
	ENDM
DCR B
JP CHC1
POP H
POP B
RET
HEIGHT: DB 1
CURSOR:DW 0

;////// קשקןה ימזן ב היףנלוך //////////////
OUTINFO:POP H
MOV A,M
INX H
ORA A 
JZ INFEND
CPI 1
JZ SETCURS
CPI 2
JZ PUTBYTE
CPI 3
JZ cINVERS
CPI 4
JZ cNORM
CPI 5
JZ PUTWORD
CPI 6
JZ chHEIGHT ; ֵֽ־ֵֽׁ ׳Ù׃ֿװױ ׳Ù׳ִֹֽֿÙָ ׃ֹֽ׳ּֿֿ׳
CPI 7
JZ chCOLOR  ;ֵֽ־ֵֽׁ ֳ׳ֵװ ׳Ù׳ִֹֽֿÙָ׃ֹֽ׳ּֿֿ׳
;////// ימב‏ו נעןףפן קשקןהים ףיםקןל /////////
PUSH H
LHLD CURSOR
CALL PUTUCHAR
LXI H,CURSOR+1
INR M
POP H

JMP OUTINFO+1
INFEND:PCHL
SETCURS:MOV A,M
STA CURSOR
INX H
MOV A,M
STA CURSOR+1
INX H
JMP OUTINFO+1
cINVERS:MVI A,16H
CALL CHARCOLOR
JMP OUTINFO+1
cNORM:MVI A,6
CALL CHARCOLOR
JMP OUTINFO+1
chHEIGHT:MOV A,M
STA HEIGHT
INX H
JMP OUTINFO+1
chCOLOR:MOV A,M
CALL CHARCOLOR
INX H
JMP OUTINFO+1
;//////// ׳Ù׳ִֿ ׃ּֿ׳ֱ ׳ 10-װֹÞ־ֿÊ ׃ֹ׃װֵֵֽ /////////
PUTWORD:
MOV E,M
INX H
MOV D,M
INX H
PUSH H
XCHG
CALL SETCIF
POP H
JMP OUTINFO+1
SETCIF:LXI B,-10000
CALL PUTCIF
LXI B,-1000
CALL PUTCIF
sBYTE:
LXI B,-100
CALL PUTCIF
LXI B,-10
CALL PUTCIF
MOV A,L
JMP OUTC2
PUTCIF:MVI E,255
INR E
DAD B
JC $-2
MOV A,L
SUB C
MOV L,A
MOV A,H
SBB B
MOV H,A
MOV A,E
OUTC2:ADI 30H
PUSH H
LHLD CURSOR
CALL PUTUCHAR
LXI H,CURSOR+1
INR M

POP H
RET
PUTBYTE:MOV A,M
INX H
PUSH H
MOV L,A
MVI H,0
CALL sBYTE
POP H
JMP OUTINFO+1
;//////////////////////////////////////////

INIT:DI
XRA A
STA PEN
STA DBLMODE
STA fGRID
STA pCODE
STA pBMP
OUT 10H
MVI A,22H
LXI H,2000H
MVI M,0
INX H
CMP H
JNZ $-4
LXI H,0A000H
MVI B,0
MVI A,0E0H
MOV M,B
INX H
CMP H
JNZ $-3
LHLD 39H
SHLD OLD39H
LXI H,APINIT
SHLD 39H
EI
LXI H,1000H
LXI D,1800H
LXI B,800H
JMP LDIR

KEYS:DB 0FEH,0FDH,0FBH,0F7H,0EFH,0BFH,0DFH,7FH
OLD39H:DW 0
KEY:DB 0

APINIT:PUSH H
PUSH D
PUSH B
PUSH PSW
LXI H,PEREP
XRA A
CMP M
JZ INIT2
DCR M
LXI D,100FH
LXI H,COLR15
INIT1:MOV A,E
OUT 2
MOV A,M
OUT 0CH
OUT 0CH
NOP
NOP
DCX H
OUT 0CH
DCR E
DCR D
OUT 0CH
JNZ INIT1
INIT2:MVI A,8AH
OUT 0
LXI H,KEYS
MVI A,0FEH
INIT3:PUSH PSW
OUT 3
IN 2
MOV M,A
POP PSW
INX H
RLC
JC INIT3
MVI A,88H
OUT 0
MVI A,255
OUT 3
XRA A
OUT 2
CALL GETCOD
POP PSW
POP B
POP D
POP H
EI 
RET

DB 0,0,0ADH,0ADH,9BH,9BH,0F2H,0F2H

DB 0,0,0ADH,0ADH,9BH,9BH,0F2H
COLR15:DB 0F2H

PEREP:DB 50H

GETCOD:XRA A
STA KEY
MOV C,A
SETCOD:MVI B,8
LXI H,KEYS
LSETC0:MOV A,M
CPI 0FFH
JNZ YKLAV
MOV A,C
ADI 8
MOV C,A
DCR B
INX H
JNZ LSETC0
RET
YKLAV:RAR
INR C
JC YKLAV
MOV A,C
STA KEY
RET


DESIGN:
CALL OUTINFO
DB 7,2,6,4,1,0,8,'gDw'
DB 6,1,4,1,11H,14H
DB 'ףפעולכי-כץעף',1,12H,14H,3,'קקןה'
DB 4,'-׀ֵֿׂ',1,13h,13h,3,'פבג',4,'-װֱֲױֳֹּׁׁ'
db 3,1,14h,14h,'קכ',4,'- ׀ֵֿׂ',3,1,15h,13h
db 'נף',4,'-',3,'תג',4,'-׀ִָֿֿׂ',1,16h,13h
db '(ץף)',3,'ףפע',4,'-ֿÞֹ׃װ',1,17h,1,3
db 'F1',4,'-׀ֵֽֿ׃װֹװ״ ץף-16+',3,'F1',4,'-ֹ־׳ֵׂ׃ֹׁ'
db 3,1,18h,1,'F2',4,'-Úֱֱֲׂװ״   ףף-8 +',3
db 'F2',4,'-ֿׂװֱֳֹׁ',1,19h,1,3,'F3',4,'-׃ֱָֿׂ־ֹװ״'
db 3,1,19h,14h,'F3',4,'-ֱׂÚֵֽׂ',3,1,1ah,1
db 'F4',4,'-ÚֱַׂױÚֹװ״',3,1,1ah,14h,'F4',4
db '-ֵׂ׳ֵׂ׃ֹׁ',3,1,1bh,1,'F5',4,'-װֱֱֲֳֹּ',3
db 1,1bh,14h,'F5',4,'-׃ִ׳ַֹ',3,1,1ch,2,'קכ',4
db '-׳Ùֲֿׂ ',3,'N',4,'-ֹֽׁ ֱֶÊֱּ>',3,1,1dh,2
db 'תג',4,'-ױֱִּ    ',3,'R',4,'-׃ֵװ״   ',3,'D'
db 4,'-ִױֲּׁׂ',3,1,1eh,2,'נף',4,'-ֵׂײֹֽ:  '
db 3,'P',4,'-׀ֵÞֱװ״ ',3,0ch,4,'-ִֽֿֿÊ'
db 3,1,1fh,3,'נף',4,'-ֲֵֽֿ־,',3,'תג',4
db '-ֻֿ׀ֹׂ  ',3,'בע2',4,'-׳Ùִָֿ'
DB 0 ;END OF INFO

RET
CLW:
MVI A,6
CALL SETCOL
LXI H,0C2CH
LXI D,0CB4H
CALL VHLINE
LXI d,942CH
CALL VHLINE
LXI H,094B4H
LXI D,0CB4H
CALL VHLINE
LXI D,942CH
CALL VHLINE

GRID: ;//עוûופכב וףפר ילי מיטרפ וףפר?//
LDA fGRID
MVI B,4
ORA A
JZ $+5
MVI B,0
MOV A,B
CALL SETCOL
LXI H,502CH
LXI D,50B4H
CALL VHLINE
LXI H,0C70H
LXI D,9470H
JMP VHLINE
;///////// PUT*bmp* /////////
PUTBMP:LXI H,0206H

LXI D,2000H
PUTB0:LDAX D
ORA A
MVI A,20H
JZ $+5
MVI A,2AH
CALL PUTUCHAR
INR E
RZ
INR H
MVI A,12H
CMP H
JNZ PUTB0

MVI H,2
INR L
JMP PUTB0
PUT16x16:
LXI H,1000H
SHLD ADDRTBL+1
LXI H,1306H
LDA pCODE
STA CODE
CALL PUTUCHAR
INR A
INR H
STA CODE2
CALL PUTUCHAR
LXI H,1307H
INR A
STA CODE3
CALL PUTUCHAR
INR A
INR H
STA CODE4
CALL PUTUCHAR
LXI H,1800H
SHLD ADDRTBL+1
CALL OUTINFO
DB 1,5,15H,2
CODE: DB 0,1,6,15H,2
CODE2:DB 0,1,7,15H,2
CODE3:DB 0,1,8,15H,2
CODE4:DB 0,0
RET
CONVERT:
PUSH PSW
XCHG
MOV L,A
MVI H,0
DAD H
DAD H
DAD H
LXI B,1000H
DAD B
XCHG
MVI B,8
CONV0:LDAX D
MVI C,8
CONV1:RLC
MVI M,0
JNC $+5
MVI M,255
INX H
DCR C
JNZ CONV1
INX D
MVI A,8
ADD L
MOV L,A
DCR B
JNZ CONV0
POP PSW
RET
GET: ;// םֱװױÛֱֻ G E T /////////////////////
LXI H,2000H
LDA pCODE
CALL CONVERT
LXI H,2008H
INR A
CALL CONVERT
LXI H,2080H
INR A
CALL CONVERT
LXI H,2088H
INR A
CALL CONVERT
CALL PUT16x16
JMP PUTBMP

PUT:  ;////////גֱװְÛֱֻ P U T /////////
LDA pCODE
LXI H,2000H
CALL BPUT
INR A
LXI H,2008H
CALL BPUT
INR A
LXI H,2080H
CALL BPUT
INR A
LXI H,2088H
CALL BPUT
JMP PUT16x16
BPUT:PUSH PSW
XCHG
MOV L,A
MVI H,0
DAD H
DAD H
DAD H
LXI B,1000H
DAD B
MVI A,8
BPUT0:PUSH PSW
MVI B,8
LDAX D
ORA A
JZ $+4
CMC
MOV A,C
RAL
MOV C,A
INX D
DCR B
JNZ BPUT0+2
MVI A,8
ADD E
MOV E,A
MOV M,C
INX H
POP PSW
DCR A
JNZ BPUT0
POP PSW
RET

;////////////  F  C  B  ///////////////

pFCB:DB 0
nFILE:DB '        '; NAME
nEXT: DB '   '
EXTENT:DB 0
S12:DS 2
fRC:DB 0
DW 0,0,0,0,0,0,0,0
CR:DB 0
Z012:DS 3
;/////// ‏פומיו/תבניףר זבךלב ////////////
FLOAD:LDA 80H
DCR A

RM
INR A
MOV C,A
MVI B,8
LXI H,nFILE
LXI D,82H
FLD0:DCR C
JZ FLD1
LDAX D
INX D
CPI 20H
JZ FLD0
MOV M,A
DCR B
INX H
JNZ FLD0
FLD1:LXI H,nFILE
LXI D,FILENAME
LXI B,8
CALL LDIR
CALL PRINTNAME  ; ׃ֱׂÚױ ׳Ù׳ִֵֵֽ ֹֽׁ ־ֱ Üֱֻׂ־

LOAD:
MVI A,23H
OUT 10H
XRA A
STA CR
MVI C,15
LXI D,pFCB
CALL 5
CPI 255
PUSH PSW
JZ LOADE
POP PSW
LXI D,1000H
MVI A,10H
LOAD1:PUSH PSW
PUSH D
MVI C,14H
LXI D,pFCB
CALL 5
POP D
ORA A
JNZ LOADE
LXI H,80H
MOV B,H
MOV C,L
CALL LDIR
POP PSW
DCR A
JNZ LOAD1
OUT 10H
RET
LOADE:
POP PSW
LXI D,pFCB
MVI C,10H ; CLOSE FILE
CALL 5
XRA A
OUT 10H
JMP BELL
SAVE: ;///// תבניףר זבךלב מב היףכ //////
LDA nFILE
CPI 32
JZ BELL
XRA A
STA CR
MVI A,23H
OUT 10H
LXI D,pFCB
MVI C,15
CALL 5
CPI 255
JZ MAKEIT ; COULDNT OPEN IT
SAVE0:MVI A,10H
LXI H,1000H
SAVE1:PUSH PSW
LXI D,80H
MOV B,D
MOV C,E
CALL LDIR
PUSH H
LXI D,pFCB
MVI C,15H
CALL 5 ; SAVE FILE
POP H
ORA A
JNZ LOADE ;ERROR
POP PSW
DCR A
JNZ SAVE1
LXI D,pFCB
MVI C,10H
CALL 5
XRA A
OUT 10H
RET
MAKEIT:MVI C,16H
LXI D,pFCB
CALL 5
CPI 0FFH
PUSH PSW
JZ LOADE
POP PSW
JMP SAVE0


CHANGENAME:
LXI H,nFILE
LXI D,FileNAME
LXI B,8
CALL LDIR
CHN00:XRA A
STA TIMCUR
CHN0:CALL PRINTNAME
CALL PUTCUR
CALL READKEY
PUSH PSW
CALL PRINTNAME
POP PSW
CPI VK
JNZ CHN01A
LXI H,FILENAME
LXI D,nFILE
LXI B,8
JMP LDIR
CHN01A:
CPI RIGHT
JNZ CHN1
LDA TIMCUR
LXI H,FILENAME
CALL ADDHL
MVI A,20H
CMP M
JZ CHN0
LXI H,TIMCUR
INR M
MVI A,7
ANA M
MOV M,A
JMP CHN0
CHN1:CPI DOM
JZ CHN00
CPI LEFT

JNZ CHN2
LXI H,TIMCUR
DCR M
JP CHN0
INR M
JMP CHN0
CHN2:CPI ZB
JNZ CHN3
LDA TIMCUR
DCR A
JM CHN0
MOV B,A
LXI H,FILENAME
CALL ADDHL
MVI A,7
SUB B
MOV B,A
MOV D,H
MOV E,L
CHN20:INX D
LDAX D
MOV M,A
INX H
DCR B
JNZ CHN20
MVI M,20H

LXI H,TIMCUR
DCR M
JMP CHN0
CHN3:CPI 40H
JZ CHN0
CPI 11H
JC CHN0
ADI 31

MOV C,A
LXI H,FILENAME
MVI A,7
CALL ADDHL
LDA TIMCUR
CPI 7
JNZ $+7
MOV M,C
JMP CHN0
MOV B,A
MVI A,7
SUB B
MOV B,A
MOV D,H
MOV E,L

CHN30:DCX D
LDAX D
MOV M,A
DCX H
DCR B
JNZ CHN30
MOV M,C
LXI H,TIMCUR
INR M
JMP CHN0
PRINTNAME:CALL OUTINFO
DB 1,1CH,17H
FILENAME:DB '        '
DB 0
RET
PUTCUR:CALL OUTINFO
DB 3,0 ; װֱֻ ֽÙ ׳ְֻּÞֹֹּ ֹ־׳ֵׂ׃ְֹ
LDA TIMCUR
MOV C,A
LXI H,FILENAME
CALL ADDHL
MOV B,M
LXI H,171CH
MOV A,C
ADD H
MOV H,A
MOV A,B
CALL PUTUCHAR
CALL OUTINFO
DB 4,0
RET
READKEY:
LDA KEY
ORA A
JZ READKEY
REPT 5
	HLT
	ENDM
RET
;/////// ִֻֿÙ ֱֻּ׳ֹÛ //////////
left equ 5
right equ 7
up equ 6
down equ 8
vk equ 3
ps equ 2
tab equ 1
zb equ 4
str equ 10
ar2 equ 11
dom equ 9
F1 EQU 12
F2 EQU 13
F3 EQU 14
F4 EQU 15
F5 EQU 16
;//////////////////////////

getaddress:
mvi h,0
mov l,a
dad h
dad h
dad h
push b
lxi b,1000h
dad b
pop b
ret
GETCOORDS:
push psw
push psw
ani 0fh
adi 2
mov h,a
pop psw
rar
rar
rar
rar
ani 0fh
ADI 6
mov l,a
pop psw
ret
;////////// ֱֲׂװֹÛֱֻ TABLE /////////
TABLE:
lxi h,1000h
shld addrtbl+1
xra a
tbl1:
call getcoords
call putuchar
inr a
jnz tbl1
sta mode
lda pCODE
sta curcur
TBL2:
lxi h,1800h
shld addrtbl+1
lda curcur
sta ecur
call outinfo
db 1,16h,0Fh,2
ecur:db 0,0
lxi h,1000h
shld addrtbl+1
lda mode
ora a
jz $+0dh
lda curcur
lxi h,timcur
cmp m
jz tbl3
call outinfo
db 3,0
lda curcur
call getcoords
call putuchar
call outinfo
db 4,0
tbl3:call readkey
push psw
lda mode
ora a
jz $+0dh
lda curcur
lxi h,timcur
cmp m
jz tbl4
lda curcur
call getcoords
call putuchar
tbl4:pop psw
lxi h,curcur
cpi up
jnz $+0ah
mvi a,-10h
add m
mov m,a
jmp tbl2
cpi down
jnz $+0ah
mvi a,10h
add m
mov m,a
jmp tbl2
cpi left
jnz $+7
dcr m
jmp tbl2
cpi right
jnz $+7
inr m
jmp tbl2
cpi ar2
rz
cpi vk
jnz tbl5
lda curcur
sta pCODE
ret
tbl5:cpi zb
jnz tbl6
lda mode
ora a
jnz tbl50
lda curcur
call getaddress
mvi a,8
mvi m,0
dcr a
inx h
jnz $-4
lda curcur
call getcoords
call putuchar
lxi h,curcur
inr m
jmp tbl2
tbl50:lda curcur
call getaddress
xchg
lda timcur
call getaddress
lxi b,8
call ldir
lda timcur
call getcoords
call putuchar
xra a
sta mode
jmp tbl2
tbl6:cpi ps
jnz tbl7
lda mode
ora a
jnz tbl60
mvi a,1
sta mode
call outinfo
db 3,0
lda curcur
sta timcur
call getcoords
call putuchar
call outinfo
db 4,0
jmp tbl2
tbl60:lda timcur
call getaddress
xchg
lda curcur
call getaddress
lxi b,8
call xdir
lda timcur
call getcoords
call putuchar
xra a
sta mode
jmp tbl2
tbl7:call bell
jmp tbl2

GETN8:lda pBMP
mov b,a
ani 8
jnz rone
lxi h,2000h
mvi a,7fh
cmp b
rnc
mvi l,80h
ret
rone:lxi h,2008h
mvi a,7fh
cmp b
rnc
mvi l,88h
ret

;////// ֱַֹֽÞֵ׃ֵֹֻ ֶױ־ֳֹֹֻ ///////////
INVERSE:
call usorss
jc inv16
call getn8
lxi d,808h
inv8:push d
mov a,m
cma
mov m,a
dcr e
inx h
jnz inv8+1
mvi a,8
add l
mov l,a
pop d
dcr d
jnz inv8
ret
inv16:lxi h,2000h
mov a,m
cma
mov m,a
inr l
jnz inv16+3
ret
ROTATION:call usorss
jnc rot8
lxi h,2000h
lxi d,2100h
lxi b,100h
rot16:mov a,m
stax d
inx h
mvi a,10h
add e
mov e,a
jnc $+4
inx d
dcx b
mov a,b
ora c
jnz rot16
bmp12bmp:lxi h,2100h
lxi  d,2000h
lxi b,100h
jmp ldir
rot8:call getn8
lxi d,2100h
lxi b,808h
rot80:push b
mov a,m
stax d
inx h

mvi a,10h
add e
mov e,a
dcr c
jnz rot80+1
pop b
mvi a,8
add l
mov l,a
mvi a,81h
add e
mov e,a
dcr b
jnz rot80
sbmp12bmp: ;//׀ֲֵֵֿׂׂ׃kֱ ֱּֽÙָ ׃ֹֽ׳ּֿֿ׳//
call getn8
lxi d,2100h
lxi b,808h
sb0:push b
ldax d
mov m,a
inx d
inx h
dcr c

jnz  sb0+1
mvi a,8
add l
mov l,a
mvi a,8
add e
mov e,a
pop b
dcr b
jnz sb0
ret

RESIZE: ;/// ֹÚֵֽ־ֵ־ֵֹ ֱׂÚֱֵֽׂ ׃ֹֽ׳ּֿֿ׳//
call usorss
jc resz16
call getn8
lxi d,2100h
lxi b,808h
resz8:push b
mov a,m
stax d
inx d
stax d
mvi a,0fh
add e
mov e,a
mov a,m
stax d
inx d
stax d
mov a,e
sbi 15
mov e,a
inx h
dcr c
jnz resz8+1
mvi a,8
add l
mov l,a
mvi a,10h
add e
mov e,a
pop b
dcr b
jnz resz8
jmp bmp12bmp
CountBits:
push h
xra a
mov b,a
mov a,m
ora a
jz $+4
inr b
inx h
mov a,m
ora a
jz $+4
inr b
mvi a,15
add l
mov l,a
mov a,m
ana a
jz $+4
inr b
inx h
xra a
ora m
jz $+4
inr b
pop h
mov a,b
ret
RESZ16:lxi d,2100h
lxi h,2000h
lxi b,808h
resz10:push b
call CountBits
cpi 2
mvi a,0
jc $+5
mvi a,255
stax d
inx d
inx h
inx h
dcr c
jnz resz10+1
mvi a,8
add e
mov e,a
mvi a,10h
add l
mov l,a
pop b
dcr b
jnz resz10
jmp sBMP12BMP

REVERSE:call usorss
jnc rvrs8
lxi h,2000h
lxi d,210fh
lxi b,1010h
rvrs16:push b
mov a,m
stax d
inx h
DCR E
dcr c
jnz rvrs16+1
mvi a,20h
add e
mov e,a
pop b
dcr b
jnz rvrs16
jmp BMP12BMP
rvrs8:call getn8
lxi d,2107h
lxi b,808h
rvrs80:push b
mov a,m
stax d
inx h
DCR E
dcr c
jnz rvrs80+1
mvi a,8
add l
mov l,a
mvi a,18h
add e
mov e,a
pop b
dcr b
jnz rvrs80
jmp sBMP12BMP

CLEAR:call usorss
jc clr16
call getn8
lxi b,808h
clr8:push b
mvi m,0
inx h
dcr c
jnz clr8+1
mvi a,8
add l
mov l,a
pop b
dcr b
jnz clr8
ret
clr16:lxi h,2000h
mvi m,0
inr l
jnz clr16+3
ret

MOVE: ;// ׁ ִ׳ְֱַֹ ֹּÛ״ ֲּֿ״Ûֵֹ ///
call usorss
rnc; no move for little ones
call readkey
cpi up
jz mup16
cpi down
jz md16
cpi left
jz mleft16
cpi right
jz mr16
cpi AR2
jnz BELL
ret
mup16:mvi b,0f0h
lxi h,2000h
lxi d,2010h
ldax d
mov m,a
inx h
inx d
dcr b
jnz $-5
mvi b,10h
mvi m,0
inx h
dcr b
jnz $-4
ret
md16:mvi b,0f0h
lxi h,20efh
lxi d,20ffh
mov a,m
stax d
dcx h
dcx d
dcr b
jnz $-5
mvi b,10h
xra a
stax d
dcx d
dcr b
jnz $-3
ret
mleft16:lxi d,2000h
lxi h,2001h
lxi b,100fh
mlft16:push b
mov a,m
stax d
inx h
inx d
dcr c
jnz mlft16+1
inx h
inx d
pop b
dcr b
jnz mlft16
lxi h,200fh
iclr16:mvi b,10h
mvi m,0
mvi a,10h
add l
mov l,a
dcr b
jnz $-7
ret
mr16:lxi h,20feh
lxi d,20ffh
lxi b,100fh
mr6:push b
mov a,m
stax d
dcx h
dcx d
dcr c
jnz mr6+1
dcx h
dcx d
pop b
dcr b
jnz mr6
lxi h,2000h
jmp iclr16

PUTIT:PUSH PSW
MOV B,A
ANI 15
ADI 2
MOV H,A
MVI A,0F0H
ANA B
RRC
RRC
RRC
RRC
ADI 6
MOV L,A
XCHG
MVI H,20H
MOV L,B
MOV A,M
ORA A
XCHG
MVI A,20H
JZ $+5
MVI A,2AH
CALL PUTUCHAR
POP PSW
RET
WHEREDBL:LDA pBMP
MOV C,A
CMA
ANI 15
MOV B,A
MOV A,C
ANI 0F0H
ORA B
RET
DISPATCHER:CALL OUTINFO
DB 3,0
LDA pBMP
STA oBMP
CALL PUTIT
LDA DBLMODE
ORA A
JZ $+9
CALL WHEREDBL
CALL PUTIT
CALL OUTINFO
DB 4,1,16H,0FH,2
oBMP:DB 0,0
CALL GRID
CALL READKEY
PUSH PSW
LDA pBMP
CALL PUTIT
LDA DBLMODE
ORA A
JZ $+9

CALL WHEREDBL
CALL PUTIT
POP PSW
CPI AR2
RZ
CPI TAB
JNZ DSP0
LDA pBMP
MOV B,A
ANI 8
MVI A,8
JZ $+5
MVI A,78H
ADD B
STA pBMP
JMP DISPATCHER
DSP0:CPI VK
JNZ $+0DH
LDA PEN
CMA
STA PEN
JMP DISPATCHER
CPI PS
JNZ DSP1
CALL USORSS
JC DSP01
LXI H,pCODE
DCR M
JMP $+0BH
DSP01:LDA pCODE
SUI 4
STA pCODE
CALL GET
JMP DISPATCHER
DSP1:CPI ZB
JNZ DSP2
CALL USORSS
JC DSP02
LXI H,pCODE
INR M
JMP $+0BH
DSP02:LDA pCODE
ADI 4
STA pCODE
CALL GET
JMP DISPATCHER

DSP2:CPI 33H
JNZ DSP3
LDA fGRID
CMA
STA fGRID
JMP DISPATCHER
DSP3:CPI 25H
JNZ DSP4
LDA DBLMODE
CMA
STA DBLMODE
JMP DISPATCHER
DSP4:CPI DOM
JNZ $+10
XRA A
STA pBMP
JMP DISPATCHER
CPI 31H
JNZ $+9
CALL PRINT
JMP DISPATCHER
CPI 2FH
JNZ $+9
CALL CHANGENAME
JMP DISPATCHER
CPI 40H
JNZ DSP5
LDA pBMP
MVI H,20H
MOV L,A
MOV A,M
CMA
MOV M,A
LDA DBLMODE
ANA A
JZ DISPATCHER
CALL WHEREDBL
MVI H,20H
MOV L,A
MOV A,M
CMA
MOV M,A
JMP DISPATCHER
DSP5:MVI B,-1
CPI LEFT
JZ DSPMOVE
MVI B,1
CPI RIGHT
JZ DSPMOVE
MVI B,-10H
CPI UP
JZ DSPMOVE
MVI B,10H
CPI DOWN
JZ DSPMOVE
CPI F1 ;F1-F5?
JC DSP6
CPI F5+1
JNC DSP6
SUI F1
MOV B,A
IN 1
CMA
ANI 60H
MOV A,B
JZ DSP51 ;NO US OR SS
ORA A
LXI H,DSP50
PUSH H
JZ INVERSE
DCR A
JZ ROTATION
DCR A
JZ RESIZE
DCR A
JZ REVERSE
JMP MOVE
DSP50:CALL PUTBMP
JMP DISPATCHER
DSP51:LXI H,DSP52
PUSH H
ANA A
JZ PUT
DCR A
JZ GET
DCR A
JZ SAVE
POP H
DCX H
DCX H
DCX H
PUSH H
DCR A
JZ LOAD
POP H
CALL TABLE
LXI H,1800H
SHLD ADDRTBL+1
CALL GET
