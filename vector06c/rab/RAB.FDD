	LDA OCTAVE1
	SUI 30H
	STA  MODE1
	DCX H
	JMP P1C0X
SET2MODE:
	LDA OCTAVE2
	SUI 30H
	STA  MODE2
	DCX H
	JMP P2C0X
SET3MODE:
	LDA OCTAVE3
	SUI 30H
	STA MODE3
	DCX H
	JMP P3C0X

;////גבעבגבמש,ץהבעמיכי,פבעולכי\\\\\
