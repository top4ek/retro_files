RET
MELODY1:DB '$'
MELODY2:DB '$'
MELODY3:DB '$'

PROGRM:LXI H,0E000H
LXI D,6000H
LXI B,2000H
CALL PEREN
CALL TURBO
LXI H,1500H
CALL REKOMP
PG0:CALL KEYBOARD
LDA YMUSIC
CPI 0
JZ PG0
MVI D,2
MVI C,0FFH
PG1:MVI B,120
LXI H,0E270H
PG2:MOV M,C
INR L
DCR B
JNZ PG2
LXI H,0F970H
MVI B,120
PG3:MOV M,C
