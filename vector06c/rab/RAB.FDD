ן
;ימידיבליתבדיי CP/M י ן‏יףפןכ üכעבמב

;//////כןהש כלAקיû, קשהבקבוםשו LOCAL GETCODE\\\\\
AR2	EQU 0BH
DOM	EQU 9
STR	EQU 10
LEFT	EQU 5
UP	EQU 6
RIGHT	EQU 7
DOWN	EQU 8
TAB	EQU 1
VK	EQU 3
ZB	EQU 4
PS	EQU 2
F1	EQU 12
F2	EQU 13
F3	EQU 14
F4	EQU 15
F5	EQU 16
SPACE	EQU 40H


SAVE4CPM MACRO
	LHLD 39H
	SHLD OLD39H
	DI
	XRA A
	OUT 10H
	LXI H,APINIT
	SHLD 39H
	LXI SP,8000H
	EI
	ENDM
QUIT2CPM MACRO
	DI
	LHLD OLD39H
	SHLD 39H
	MVI A,23H
	OUT 10H
	EI
	RST 0 ; קשטןה ק CP/M ֹֹּ MDOS
	ENDM
PUSHA MACRO REG
	PUSH B
	PUSH D
	PUSH H
	IF NOT NUL REG
	PUSH PSW
	ENDIF
	ENDM
POPA MACRO REG
	IF NOT NUL REG
	POP PSW
	ENDIF
	POP H
	POP D
	POP B
	ENDM

RST07 MACRO MUSIC,NOKEY
;  תמב‏ומיס:  MUSIC-קףפבקיפר נןההועצכץ םץתשכי
;     NOKEY -  קשכלא‏יפר נעוןגעבתןקבמיו כןהןק GETKEY
APINIT:
	LOCAL INIT1,INIT2,INIT3,GETCODE
	LOCAL YKLAV,SETCOD,SETCO
	LOCAL RUSCON,@NAJ,@NONAJ
	PUSHA 1
	LHLD TIMER ;פבךםועב
	INX H	   ;טקבפבופ מב 21 םימץפץ
	SHLD TIMER ;(65536/50)
	LXI H,PEREP
	XRA A
	CMP M
	JZ INIT2
	DCR M
	LXI D,100FH
	LXI H,COLR15
INIT1:
	MOV A,E
	OUT 2
	MOV A,M
	OUT 0CH
	OUT 0CH
	NOP
	NOP
	DCX H
	OUT 0CH
	DCR E
	DCR D
	OUT 0CH
	JNZ INIT1
INIT2:
	MVI A,8AH
	OUT 0	
	LXI H,KEYS
	MVI A,0FEH
INIT3:
	MOV B,A
	OUT 3
	IN 2
	MOV M,A
	MOV A,B
	INX H
	RLC
	JC INIT3
	IF NUL NOKEY
	CALL GETCODE
	ENDIF
	MVI A,88H
	OUT 0
	LDA SCROLL
	OUT 3
	LDA BORDER
	OUT 2

	IF NUL NOKEY
	LXI H,RUSCON
	IN 1
	RLC
	JC @NONAJ
	XRA A
	ORA M
	JZ @NAJ
	DCR M
	LDA KEYPAD
	XRI 2
	STA KEYPAD
	JMP @NAJ
@NONAJ:	MVI M,1
@NAJ:
	LDA KEYPAD
	ANI 2
	RLC
	RLC
	OUT 1
	ENDIF

	IF NOT NUL MUSIC
	LDA YCHAN1
	ORA A
	CNZ PLAY1CHAN
	LDA YCHAN2
	ORA A
	CNZ PLAY2CHAN
	LDA YCHAN3
	ORA A
	CNZ PLAY3CHAN
	ENDIF
	POPA 1
	EI 
	RET
KEYS:	DS 8
KEY:	DB 0
KEYPAD:	DB 0
RUSCON:	DB 1
SCROLL:	DB 255
BORDER:	DB 0
OLD39H:	DW 0
COLR0:	DB 0,0,7,7,38H,38H,2BH,2BH,0C0H,0C0H
	DB 0C6H,0C6H,0E8H,0E8H,0ADH
COLR15:	DB 0ADH
PEREP:	DB 50
TIMER:	DS 2

	IF NUL NOKEY
GETCODE:
	XRA A
	STA KEY
	MVI C,0
SETCOD:	MVI B,8
	LXI H,KEYS
SETCO:	MOV A,M
	CPI 0FFH
	JNZ YKLAV
	MOV A,C
	ADI 8
	MOV C,A
	DCR B
	INX H
	JNZ SETCO
	RET
YKLAV:	RAR
	INR C
	JC YKLAV
	MOV A,C
	STA KEY
	RET
	ENDIF
	ENDM
; כןמוד RST07 םבכען

WAITKEY MACRO
	LDA KEY
	ORA A
	JZ $-4
	ENDM
WAITRKEY MACRO
	LOCAL WRK
WRK:	RND
	LDA KEY
	ANA A
	JZ WRK
	ENDM
LPAUSE MACRO
;/// ־ֲֵּֿ״Ûֱׁ ׀ֱױÚֱ (1/10 ׃) |||
	REPT 5
	HLT
	ENDM
	ENDM


;CLS FOR CP/M
CLS	MACRO
	LOCAL CLS1,CLSEND
	JMP CLSEND
@CLS:
	LXI H,8000H
	LXI D,6000H
	MVI B,0
CLS1:	MOV M,B
	INX H
	DCX D
	MOV A,D
	ORA E
	JNZ CLS1
	RET
CLSEND:
CLS	MACRO
	CALL @CLS
	ENDM
	CLS
	ENDM

TURBOCLS MACRO
	LOCAL TC1,TCEND
	JMP TCEND
@TC:
	DI
	LXI H,0
	DAD SP
	LXI SP,0E000H
	LXI D,0
	LXI B,0CFFH
	XRA A
TC1:	REPT 4
	PUSH D
	ENDM
	DCX B
	CMP B
	JNZ TC1
	SPHL
	EI
	RET
TCEND:
TURBOCLS MACRO
	CALL @TC
	ENDM
	TURBOCLS
	ENDM

FATAXCLS MACRO
	LOCAL FTX1,FTX2,FTX0,FTXEND
	JMP FTXEND
@FATAX:
	LXI H,8000H
	LXI D,9FFFH
FTX0:	MVI C,2
FTX1:	MVI B,3
	PUSH H
FTX2:	MVI M,0
	MVI A,20H
	ADD H
	MOV H,A
	DCR B
	JNZ FTX2
	POP H
	XCHG
	DCR C
	JNZ FTX1
	DCX D
	INX H
	MOV A,H
	CPI 90H
	JNZ FTX0
	RET
FTXEND:
FATAXCLS MACRO
	CALL @FATAX
	ENDM
	FATAXCLS
	ENDM


;	 BITMAP.LIB

; ׃ְֱִ ׳ִָֿׁװ ֱֻֽׂÙ:
;  POINTCHAR - ׳Ù׳ִֿ ׃ֹֽ׳ֱּֿ ׀ֿ װֿÞֱֻֽ ׳ ְֲּֿÊ ׀ֿׂ׀ֳֹֹֿׂ
;  		, ׳׳ִֿ ׃װֹֻֿׂ ׃ ֹ׃׀ּֿ״Úֿ׳ֱ־ֵֹֽ PUTPCHAR
;  GETPUT - ֿ־ֹ ֹ ׳ בֵֶֹֻׂ ֵ׃װ״ נץפש ֹ חüפש!!!
;   PUTRESIZE - ׀ֿװׁׂ׃־ֱׁ ׃ֱֱֲ, ׳Ù׳ִֹֿװ ֱֲֿׂÚ, Úֱ׀ֽֿ־ֵ־־ÙÊ 
;                GET'ֽֿ, ְֲַּֿֿ ֱׂÚֱֵֽׂ!!!!
;		 ( ׳ִָֹֿװ ׳ ֱֻֽֿׂ GETPUT)


POINTCHAR MACRO
PUTPCHAR:
; קטןה - A-CODE, HL-COORDS (0-255),  BC - size (1-32)
	LOCAL PUTPC1,PUTPC2
	PUSHA
	PUSH H
	MOV L,A
	MVI H,0
	DAD H
	DAD H
	DAD H
	LXI D,TABLSYM
	DAD D
	XCHG
	MVI A,8
	POP H
PUTPC1:	PUSH PSW
	PUSH B
	PUSH H
	PUSH B
	LDAX D
	MVI C,8
PUTPC2:
	PUSH  B
	RLC
	PUSH PSW
	LDA SYMCOLOR
	JC $+6
	LDA BACKCOLOR
	CALL SETCOLOR
	CALL PLOT
	INR  H
	DCR B
	JNZ $-5
	POP PSW
	POP B
	DCR C
	JNZ PUTPC2
	POP B
	POP H
	INR L
	DCR C
	JNZ PUTPC1+2
	POP B
	INX D
	POP PSW
	DCR A
	JNZ PUTPC1
	POPA
	RET

PUTpSTRING:
;קטןה- DE-ֱִֵׂ׃ ASCIIZ, HL-ִֻֿֿׂ.XY, BC-ֱׂÚֵֽׂ dX,dY (1-32)
	LDAX D
	ORA A
	INX  D
	RZ
	CALL PUTPCHAR
	MOV A,B
	ADD A
	ADD A
	ADD A
	ADD H
	MOV H,A
	JNC PUTpSTRING
	MVI H,0
	MOV A,C
	ADD A
	ADD A
	ADD A
	ADD L
	MOV L,A
	JMP PUTpSTRING

SYMCOLOR:
	DB 7
BACKCOLOR:
	DB 0
	ENDM
   ; { POINTCHAR }

GETPUT MACRO
GET:
;קטןה - HL-XY, DE-ADDRR OF IM_BUF, BC-dY,dX (1-255)
; SIZE of IM_BUF == B*(C/2)+2 bytes of MEMORY!
	LOCAL GET1,GET2
	PUSH B
	PUSH H
	PUSH  PSW
	XCHG
	MOV M,B  ;dY IN IMAGE_BUFFER
	INX H
	MOV M,C  ;dX THERE TO
	INX H
	XCHG
GET1:	PUSH B
	PUSH H
	CALL GETCOLOR
	RAL
	RAL
	RAL
	RAL
	ANI 0F0H
	STAX D
	DCR C
	JZ GET2
	INR H
	CALL GETCOLOR
	XCHG
	ORA M
	MOV M,A
	XCHG
	INX D
	INR H
	DCR C
	JNZ GET1+2
	DCX D
GET2:	INX D
	POP H
	INR L
	POP B
	DCR B
	JNZ GET1
	POP PSW
	POP H
	POP B
	RET

PUT:
; ׳ִָֿ - HL-XY (0-255), DE-ADDRESS of IMAGE_BUFFER
	LOCAL PUT1,PUT2
	PUSHA
	PUSH PSW
	XCHG
	MOV B,M
	INX H
	MOV C,M
	INX H
	XCHG
PUT1:	PUSH H
	PUSH B
	LDAX D
	RRC
	RRC
	RRC
	RRC
	CALL SETCOLOR
	CALL PLOT
	DCR C
	JZ PUT2
	INR H
	LDAX D
	CALL SETCOLOR
	CALL PLOT
	INR H
	INX D
	DCR C
	JNZ PUT1+2
	DCX D
PUT2:	INX D
	POP B
	POP H
	INR L
	DCR B
	JNZ PUT1
	POP PSW
	POPA
	RET

PUTRESIZE:
; קטןה: HL-COORDS (0-255), DE- ADDR of IM_BUF
;  װֱֻײֵ ׳ BC - NHEIGHT (קשףןפב), NWIDTH (ûיעימב):
; װֲֵׂױֵֽÙֵ ֱׂÚֵֽׂÙ ֱֲֿׂÚֱ (0-255)!
; װֲֵׂױְװ׃ׁ  MATH.LIB, GRAPH.LIB, APINIT.LIB (PUSHA,POPA)
	LOCAL HEIGHT,WIDTH,NHEIGHT,NWIDTH
	LOCAL HQUOT,HREMND,WQUOT,WREMND
	LOCAL ADDRPUT,SKIPPIXEL,SCALEINI
	LOCAL PUTRS1,LINESCALE,PUTRS2,PUTRS3
	LOCAL SKIPLINE
	PUSHA
	MOV A,B
	STA NHEIGHT
	MOV A,C
	STA NWIDTH
	LDAX D
	STA HEIGHT
	INX D
	LDAX D
	STA WIDTH
	MOV C,A
	INX D
	XCHG
	SHLD ADDRPUT
	XCHG
	LDA NWIDTH
	CALL DIVAC
	STA WQUOT
	MOV B,C
	MVI C,0
	LDA WIDTH
	CALL DIVBCA
	MOV A,C
	STA WREMND
	LDA HEIGHT
	MOV C,A
	LDA NHEIGHT
	CALL DIVAC
	STA HQUOT
	MOV B,C
	MVI C,0
	LDA HEIGHT
	CALL DIVBCA
	MOV A,C
	STA HREMND
	MVI B,80H ; SUMMER FOR HEIGHT/2
SCALEINI:
	LDA HREMND
	ADD B
	MOV B,A
	LDA HQUOT
	ACI 0
	JZ SKIPLINE
	MOV C,A
PUTRS1:	XCHG
	LHLD ADDRPUT
	XCHG
	LDA WIDTH
	PUSH B
	MOV C,A
	PUSH H
	MVI B,80H
LINESCALE:
	LDAX D
	REPT 4
	RRC
	ENDM
	CALL SETCOLOR
	LDA WREMND
	ADD B
	MOV B,A
	LDA WQUOT
	ACI 0
	JZ SKIPPIXEL
	CALL PLOT
	INR H
	DCR A
	JNZ $-5
SKIPPIXEL:
	DCR C
	JZ PUTRS2
	LDAX D
	CALL SETCOLOR
	LDA WREMND
	ADD B
	MOV B,A
	LDA WQUOT
	ACI 0
	JZ $+11
	CALL PLOT
	INR H
	DCR A
	JNZ $-5
	INX D
	DCR C
	JNZ LINESCALE

	DCX D
PUTRS2:	INX D
	POP H
	INR L
	NOP
	POP B
	DCR C
	JNZ PUTRS1
	XCHG
PUTRS3: SHLD ADDRPUT
	XCHG
	LDA HEIGHT
	DCR A
	STA HEIGHT
	JNZ SCALEINI
	POPA
	RET
SKIPLINE:
	XCHG
	LHLD ADDRPUT
	LDA WIDTH
	RAR
	JNC $+4
	INR A
	ADDHL ; new i8080 instruction: HL=HL+A
	JMP PUTRS3

HEIGHT:	DB 0
WIDTH:	DB 0
ADDRPUT:
	DW 0
NWIDTH:	DB 0
NHEIGHT:
	DB 0
HQUOT:	DB 0
HREMND:	DB 0
WQUOT:	DB 0
WREMND:	DB 0
	ENDM
  ; { GETPUT }


;//////////  GAME2P.LIB \\\\\\\\\\\\\
;*****   יחעןקבס גיגליןפוכב     *****
;
;MAKROS:	KEYS2P,CHAR16 (BY 26JAN2000)gDw

;> ןגףלץציקבמיו קףוך כלקיבפץעש
;> גשףפעשך קשקןה ףיםקןלב  מב üכעבמ
;> נןהנעןחעבםםש תבהבמיס כלבקיû
;
;
;

;
;ןפףאהב קיהמן, ‏פן הלס עבגןפש üפןך גיגליןפוכי
;ףלוהץופ נןהכלא‏בפר APINIT.LIB+GARPH.LIB

TABL2SYM EQU TABLSYM+800H ;פבגלידב ףיםקOלןק 16ָ16

; !!!!!!!!!!! KEYS2P !!!!!!!!!!!!
KEYS2P	MACRO PLAYER2,xtKEY
	LOCAL GETKEY,GETK0,GETK1
;ץףפבמןקיפו PLAYER2(לאגןו תמב‏ומיו)Dלס 2-ט יחעןכןק
;ץףפבמןקיפו xtKEY הלס יףנןלרתןקבמיס 6-כלבקיû קםוףפן 5

;קשגןע קמץפע.כןהב מבצבפיס
;צהופ נןכב מו מבצבפב
GETKEY:
	PUSHA
GETK0:	MVI B,7
	LXI H,KEYS+7;םבףףיק כלבקיû, ץףפ.RST07
GETK1:	MOV A,M
	CPI 255 ;וףפר מבצבפיו?
	JNZ GETK2;הב!
	DCX H
	DCR B
	JP GETK1
	LPAUSE ;קשהןטמום
	JMP GETK0 ; נן מןקןך
GETK2:	MVI C,255
	INR C
	RAL
	JC $-2
	MOV A,C
	RRC
	RRC
	RRC
	ORA B
	MOV B,A
	MVI A,255
	CMP M  ;כלבקיûב ןפנץ‎ומב?
	JNZ $-1 ;מופ-קו‏משך דיכל
	LPAUSE
	MOV A,B ;קועמום כןה B <A>
	POPA
	RET ;קשטןה ף כןהןם מבצבפיס ק <A>
INITKEYS:
;נועוןנעוהולומיו כלבקיû
;קטןה: A=0 הלס נועקןחן יחעןכב
;      ב=1 הלס קפןעןחן (וףלי תבהבמ PLAYER2)
;      L-כץעףןע נן  Y(0-30)חהו קשקןהיפר ףפעןכי
	LXI D,sNUMPL1
	IF NUL PLAYER2
	ELSE
	ORA A
	JZ $+6
	LXI D,sNUMPL2
	MOV B,A
	ENDIF
	MVI H,11 ;כןןעה.ט הלס  קשקןהב ףפעןכי
	MVI A,7
	CALL CHARCOLOR ;דקופ
	CALL PUTSTRING
	INR L
	MVI H,5
	LXI D,sPRKEY
	MVI A,5
	CALL CHARCOLOR
	CALL PUTSTRING
	MVI H,15H
	MOV A,H
	CALL CHARCOLOR ;INVERSE ON
	LXI D,sKEYNAMES ;מבתקבמיס וגבממשט כלבקיû, םבפר יט
	IF NOT NUL PLAYER2
	XRA A
	ORA B
	LXI B,PL1KEYS ;כןהש כלבקיû 1-חן יחעןכב
	JZ $+6
	LXI B,PL2KEYS ;כןהש כלבקיû 2-חן יחעןכב
	ELSE
	LXI B,PL1KEYS
	ENDIF
	IF NUL xtKEY
	MVI A,5
	ELSE
	MVI A,6
	ENDIF
	LOCAL INK1
INK1:	PUSH PSW
	CALL PUTSTRING ;קשקוהום ףפעןכץ ף מבתקבמיום כלקיûי
	CALL GETKEY ;צהום מבצבפיס
	STAX B	   ;תבניûום כןה ק נבםספר
	INX B
	POP PSW
	DCR A
	JNZ INK1
	RET ;{INITKEYS}

PL1KEYS:  ;כןהש נעןחעבםםמשו כלבקיû הלס 1-חן יחעןכב
	DB 40H,0,20H,60H,080H,0A0H
sNUMPL1:
	DB '1-',217,202,32,201,199,210,207,203,0
	IF NOT NUL PLAYER2
PL2KEYS:
	DB 46H,6,0C4H,0C7H,24H,0A5H
sNUMPL2:
	DB '2-',207,202,32,201,199,210,207,203,0
;מבהניףר '2-ֿÊ ַֹֻֿׂ' ׳ כןי-8, םבפר וו תב מןחץ
	ENDIF	
;הבלוו מבהניףר:'מֱײֹֽװֵ ֱֻּ׳ֹÛױ '
sPRKEY:	DB 238,193,214,205,201,212,197,32
	DB 203,204,193,215,201,219,213,32,0
sKEYNAMES:
	DB 247,247,229,242,232,32,0 ;קקועט
	DB 247,238,233,250,32,32,0  ;קמית
	DB 247,240,242,225,247,239,0;קנעבקן
	DB 247,236,229,247,239,32,0 ;קלוקן
	DB 239,231,239,238,248,32,0 ;ןחןמר
	DB 247,249,226,239,242,32,0 ;קשגןע

;ס‏וךכי ףן זלבחבםי מבצבפשט כלבקיû
;
KEY1P:	DB 0
	IF NOT NUL PLAYER2
KEY2P:	DB 0
	ENDIF
KEYBOARD:
;ןףמןקמב ףבגב ץףפבמןקכי זלבחןק מבצבפשט כלבקיû
;זלבחי ץףפבמבקליקבאפףס ףנעבקב מבלוקן ק פןם נן-
;עסהכו,ק כןפןעןם נועו‏יףלומש מבתקבמיס כלבקיû קקועטץ:
;גיפש KEY1P,KEY2P:
;d0- UP, d1- DOWN, d2- RIGHT, d3- LEFT
;d4- FIRE, d5- FIRE2 (CHOICE, JUMP etc.)
;וףלי 1, פן ףןןפקופףפקץא‎בס כלבקיûב מבצבפב
;ק הבממשך םןםומפ, ימב‏ו גיפ עבקומ 0
;קףו כבכ ץ לאהוך, קףו נן-עץףףכי
;פןלרכן כלבקיבפץעב ץ קוכפןעב  כעיקבס
;כמןנכי  מבציםבאפףס ‏ועות צןנץ,ןך ‏ועות עבת
;ףוך‏בף 11:30 מן‏י 26 ׁ־׳ֱׁׂ 2000 ֱִַֿ ֿװ ׂ.ט.

	LXI D,PL1KEYS+5
	MVI C,0
	REPT 6
	LDAX D
	ANI 7
	LXI H,KEYS ;ףכבמ-כןהש ית RST07(APINIT.LIB)
	XLAT B
	LDAX D
	RLC
	RLC
	RLC
	ANI 7
	LXI H,NUMBIT ;ב üפן םבףיק ית POINT(GRAPH.LIB)
	XLAT ; new i8080 instruction: MOV A,[HL]+A
	ANA B
	JNZ $+4 ;גיפ וףפר, מבצבפיס מופ.מו  נן-עץףכי כבכ-פן
	STC
	ROL C
	DCX D
	ENDM
	STA KEY1P ;C STORE IN MEMORY

	IF NOT NUL PLAYER2
;הלס קפןעןחן יחעןכב נעןהולשקום במבלןחי‏מץא נעןדוהץעץ
	LXI D,PL2KEYS+5
	MVI C,0
	REPT 6
	LDAX D
	LXI H,KEYS
	ANI 7
	XLAT B
	LDAX D
	RLC
	RLC
	RLC
	ANI 7
	LXI H,NUMBIT
	XLAT
	ANA B
	JNZ  $+4
	STC
	ROL C
	DCX D ;מב ףלוה.כןה
	ENDM
	STA KEY2P
	ENDIF
	RET ;קףו?{KEYBOARD}

	ENDM
;תהוףר כןמוד םבכעב KEYS2P PLAYER2,xtKEY



CHAR16	MACRO
;
; גשףפעשך קשקןה ףיםקןלב 16x16 
;ףיםקןל הןלצומ ףןףפןספר ית 4 םבלשט(8ָ8)
;קשקןהספףס: 1 2
;	    3 4
;ףיםקןלש םןצמן מבעיףןקבפר ק SISE
;ילי ק גץהץ‎ום ISE(IMAGE SYMBOL EDITOR)
WHPL:	DB 0A0H
;קטןה:HL-CURSOR X,Y(0..1FH),B - KOD 1-חן ףיםקןלב ית פבגלידש
PUT16x16:
	PUSHA
	XCHG
	MVI H,0
	MOV L,B
	DAD H
	DAD H
	DAD H
	LXI B,TABL2SYM;בהעוף מב‏בלב פבגל.ףיםקןלןק
	DAD B
	XCHG
	LDA WHPL ;חלןגיהומ ףןהועצ.ףפ.גבךפ נלןףכ.
	ORA H
	MOV H,A
	MOV A,L
	ADD A
	ADD A
	ADD A ;*8
	CMA
	MOV L,A
;יפבכ,פונוער ק HL-בגףןלאפמשך בהעוף  VRAM
;	A ק DE-בהעוף גבךפ קשקןהיםןחן  ףיםקןלב
	LDAX D
	MOV M,A
	REPT 7
	INX D
	DCR L
	LDAX D
	MOV M,A
	ENDM
;קשקולי נועקשך ףיםקןל.Tונוער קשקןהים קפןעןך!!!
	MVI A,8 ;נעיגבקים מב 1 גןלרûו
	ADD L   ;הלס Cןתהבמס נעןףפןחן םבכעב
	MOV L,A
	INR H
	REPT 8
	INX D
	DCR L
	LDAX D
	MOV M,A
	ENDM

	DCR L  ;מו תבגץהר נען üפץ כןםבמהץ
	DCR H
	INX D
	LDAX D ;קשקןהים 3-יך ףיםקןל
	MOV M,A
	REPT 7
	INX D
	DCR L
	LDAX D
	MOV M,A
	ENDM

	MVI A,8
	ADD L
	MOV L,A ;קועמום ףפעןכץ
	INR H   ;ףהקימום ףפןלגוד
	REPT 8
	INX D ;קשקןהים 4-שך, נןףלוהמיך,ףיםקןל
	DCR L
	LDAX D
	MOV M,A
	ENDM
	POPA
	RET

;פונוער קשקןהים ףיםקןל 8ָ8.
;קטןה: B - KOD ףיםקןלב, C - ףהקיח קמית ףיםקןלב(0/4)
;	HL - CURSOR  X, Y (0..1FH) RESP.
PUT8x8:	PUSHA
	MVI D,0
	MOV E,B
	LDA WHPL
	ORA H
	MOV B,A
	MOV A,L
	ADD A
	ADD A
	ADD A
	CMA
	SUB C
	MOV C,A
	XCHG
	DAD H
	DAD H
	DAD H
	LXI D,TABL2SYM
	DAD D
	REPT 8
	MOV A,M
	STAX B
	INX H
	DCR C
	ENDM
	POPA
	RET
;קשקןה ףן ףהקיחןם קנעבקן מב 4 פן‏כי:
;קטןה - HL-CURSOR X,Y  ; B -CODE, C -SHIFT DOWN
PUT8x8X:
	PUSHA
	MVI D,0
	MOV E,B
	LDA WHPL
 	ORA H
	MOV B,A
	MOV A,L
	ADD A
	ADD A
	ADD A
	CMA
	SUB C
	MOV C,A
	XCHG
	DAD H
	DAD H
	DAD H
	LXI D,TABL2SYM
	DAD D
	XCHG
	REPT 8
	LDAX D
	MVI H,0
	MOV L,A
	DAD H
	DAD H
	DAD H ; ףהקימץלי קלוקן מב 4 פן‏כי
	DAD H ;
	MOV A,L
	INR B
	STAX B ; ניûום ק קןתץ
	MOV A,H
	DCR B
	STAX B
	INX D
	DCR C  ;ףלוה.ףפעןכב
	ENDM
	POPA
	RET ;קףו???
;ףפיעבום ףיםקןלש 8ָ8
DEL8x8:
	PUSHA
	LDA WHPL
	ORA H
	MOV H,A
	MOV A,L
	ADD A
	ADD A
	ADD A
	CMA
	SUB C
	MOV L,A
	XRA A
	MOV M,A
	REPT 7
	DCR L
	MOV M,A
	ENDM
	POPA
	RET
DEL8x8X:
	PUSHA
	LDA WHPL
	ORA  H
	MOV H,A
	MOV A,L
	ADD A
	ADD A
	ADD A
	CMA
	SUB C
	MOV L,A
	XRA A
	MOV M,A
	INR H
	MOV M,A
	REPT 7
	DCR H
	DCR L
	MOV M,A
	INR H
	MOV M,A
	ENDM
	POPA
	RET



;תבקועûילי קשקןה ףיםקןלב(26סמק2000ׂט,12:07בם(מן‏י))
	ENDM

; GRAPH.INC
; 2 MACROS BY 15 JANUARY OF 2000:
;   POINT,CHAR
; 3 MACRO AT 20JAN2000:BOLDCHAR
; USING MATH.LIB,APINIT.LIB

TABLSYM	EQU 800H  ; בהעוף פבגלידש ףיםקןלןק (2KB)

POINT	MACRO
	LOCAL WHCOL
PLOT:
	PUSHA 1
	MVI A,7
	ANA H
	LXI D,NumBit
	ADD E
	MOV E,A
	MOV A,H
	RRC
	RRC
	RRC
	ANI 1FH
	ORI 80H
	MOV H,A
	MOV A,L
	CMA
	MOV L,A
	LXI B,2000H
	LDAX D
	MOV D,A
	NOP
	ORA M
	MOV M,A
;	REPT 2	- הלס נןההועצכי 4-וט נלןףכןףפוך ץגעבפר ';'
	DAD B
	MOV A,D
	NOP
	ORA M
        MOV M,A
;	ENDM	- ףם. כןםםומפבעיך קשûו י מיצו נן לֹףפץ
	DAD B
	MOV A,D
	NOP
WHCOL:	ORA M
	MOV M,A
	POPA 1
	RET

; ףלוהץא‎יך םבכע נעיםומומ הלס פןחן,
; ‏פןגש פבגלידב NUMBIT מו נועוCוכבלבףר
; ף ןגלבףפרא 0FFH-100H
; ימב‏ו ףבגש POINT & GETCOLOR מוקועמן גץהץפ עבגןפבפר
	LOCAL ZBL
ZBL	EQU LOW $
	IF ZBL GT 0F8H ;ZBL > 0F8H?
	DS 100H-ZBL    ;הב- נעןנץףכבום גבךפש הן ףלוה.גלןכב
	ENDIF		;קףו

NumBit:	DB 80H,40H,20H,10H,8,4,2,1
SETCOLOR:
 ;ץףפבמןקכב דקופב הלס ףAגש PLOT
	LOCAL  SETC0,SETC1,SETC2,xCOLOR,SETC3
	PUSH H
	ANI 0FH
	LXI H,xCOLOR ;פוכץ‎יך דקופ = ץףפבמבקליקבוםןםץ?
	CMP M
	JZ SETC3
	MOV M,A ;פוכ.דקופ=ץףפ.
	PUSH D
	PUSH PSW
	MVI D,2  ; ֹֹּ MVI D,3 הלס קכלא‏ומיס I-ןך נלןדכ.
	LXI H,WHCOL
SETC0:
	RRC
	JNC SETC1
	MVI M,0B6H
	DCX H
	MVI M,0
	JMP SETC2
SETC1:	MVI M,0A6H
	DCX H
	MVI M,2FH  ; 'CMA'
SETC2:  
	REPT 4
	DCX H
	ENDM
	DCR D
	JP SETC0
	POP PSW
	POP D
SETC3:
	POP H
	RET
xCOLOR:	DB 5AH ;פוכץ‎יך דקופ
; VERTICAL/HORIZONTAL LINE
;דקופ לימיי תהבופףס ף נןםן‎רא SETCOLOR (כבכ י הלס פן‏כי)
;מוןגטןהיםן ףלוהיפר, ‏פןגש ליגן X1=X2, ליגן Y1=Y2
;			ילי X2-X1=Y2-Y1
;ימב‏ו לימיס מו נןלץ‏יפףס
VHLINE:
	LOCAL VHL0,VHL1
	PUSHA
	LXI B,0
	MOV A,H
	CMP D
	JZ $+10
	MVI B,1
	JC $+5
	MVI B,-1
	MOV A,L
	CMP E
	JZ  $+10
	MVI C,1
	JC $+5
	MVI C,-1
VHL0:	CMPHD   ;HL=DE?
	JZ VHL1 ;הב- קשטןה
	CALL PLOT
	MOV A,H
	ADD B
	MOV H,A
	MOV A,L
	ADD C
	MOV L,A
	JMP VHL0
VHL1:	POPA
	RET

; ־ֱִָֹֽֿ ֳ׳ֵװ װֿÞֹֻ HL ׳ A
GETCOLOR:
	PUSHA
	MOV A,L
	CMA
	MOV L,A
	MVI A,7
	ANA H
	LXI D,NumBit
	ADD E
	MOV E,A
	MOV A,H
	RRC
	RRC
	RRC
	ANI 1FH
	ORI 80H
	MOV H,A
	LDAX D
	MOV C,A
	LXI D,2000H
	MOV B,E
	ANA M
	JZ $+4
	STC
	MOV A,B
	RAL
	MOV B,A
	MOV A,C
	DAD D
	ANA M
	JZ $+4
	STC
	MOV A,B
	RAL
	MOV B,A
	MOV A,C
	DAD D
	ANA M
	JZ $+4
	CMC
	MOV A,B
	RAL
;	MOV B,A  - הלס נןההועצכי I-ןך
;	MOV A,C  -  נלןףכןףפי ץגעבפר  
;	DAD D    - תמבכי  ';'
;	ANA M
;	JZ $+4
;	STC
;	MOV A,B
;	RAL
	POPA
	RET
;
DELPIXEL:
;ץהבלומיו פן‏כי ף  üכעבמב (גשףפעןו)
;	קטןה - HL - KOOעהימבפב  0.255 נן ט,Y ףןןפקופ.
	PUSHA 1
	MVI A,7
	ANA H
	LXI D,NUMBIT
	ADD E
	MOV E,A
	MOV A,H
	RRC
	RRC
	RRC
	ANI 1FH
	ORI 80H
	MOV H,A
	MOV A,L
	CMA
	MOV L,A
	LXI B,2000H
	LDAX D
	CMA
	MOV D,A
	ANA M
	MOV M,A
	DAD B
	MOV A,D
	ANA M
	MOV M,A
	DAD B
	MOV A,D
	ANA M
	MOV M,A
;	DAD B  ;הלס נןההועצכי 4-עוט נלןףכןףפוך
;	MOV A,D ;ץגעבפר תמבכי ';' ק מב‏בלו ףפעןכ
;	ANA M
;	MOV M,A
	POPA 1 ;קןןףפ. קףו עוחי
	RET    ; קתע   PO - RUSSKI

	ENDM
;  Úִֵ׃״ ֻֿ־ֳֵ ֱֻֽֿׂ׃ֱ POINT

;///// קשקןה ףיםקןלב מב üכעבמ ק 3-ט נלןףכןףפסט //////
CHAR MACRO
PUTUCHAR:
	LOCAL PUC1,PUC2
	PUSHA
	PUSH PSW
	XCHG
	MOV L,A
	MVI H,0
	DAD H
	DAD H
	DAD H
ADDRTBL:
	LXI B,TABLSYM ;ףלןצים ף בהעוףןם מב‏בלב
	DAD B 	; פבגלידש ףיםקןלןק	
	XCHG
	MVI A,80H
	ORA H
	MOV H,A
	MOV A,L
	ADD A
	ADD A
	ADD A
	CMA
	MOV L,A
	MVI B,8	
	;
PUC1:	LDA HEIGHT
	MOV C,A  ;//////׳Ù׃ֿװֱ ׃ֹֽ׳ֱּֿ//////
PUC2:
	REPT 2  ; ילי REPT 3 הלס נןההועצכי 4-וט נלןףכOףפוך
	  LDAX D
	  NOP
	  MOV M,A
	  MVI A,20H
	  ADD H
	  MOV H,A
	  ENDM
	LDAX D
PCOL1:	NOP ; ןגעבגןפכב (nop,xra a,cma)
	mov m,a
	MVI A,0C0H
	ADD H
	MOV H,A
	DCR L
	DCR C
	JNZ PUC2
	INX D
	DCR B
	JNZ PUC1
	POP PSW
	POPA
	RET
HEIGHT:	DB 1

;/////// ױ׃װֱ־ֿ׳ֱֻ ֳ׳ֵװֱ ִּׁ ׃ֹֽ׳ּֿֿ׳,׳Ù׳ִֹֽֿÙָ PUTUCHAR ///
;
CHARCOLOR:
	LOCAL CHC1
	PUSH B
	PUSH H
	MOV B,A
	MVI C,0
	ANI 10H
	JZ $+5
	MVI C,2FH   ;'CMA'
	MOV A,B
	MVI B,2  ;הלס קכלא‏ומיס I-ןך נלןףכןףפי- MVI B,3
	LXI H,PCOL1
CHC1:	RRC
	MOV M,C
	JC $+5
	MVI M,0AFH
	REPT 7
	DCX H
	ENDM
	DCR B
	JP CHC1
	POP H
	POP B
	RET

;////// קשקןה ימזן ב היףנלוך //////////////
OUTINFO:
	LOCAL INFEND,SETCURS,HEXOUT,TWOCIFR
	LOCAL TABX,tBYTE
	LOCAL PUTBYTE,PUTWORD
	LOCAL chHEIGHT,chCOLOR,CRLF
	LOCAL PUTCIF,SETCIF,OUTC2,sBYTE
	POP H
	MOV A,M
	INX H
	ORA A 
	JZ INFEND
	CPI 1
	JZ SETCURS
	CPI 2
	JZ PUTBYTE
	CPI 3
	JZ HEXOUT ;קשקןה HEX-‏יףלב
	CPI 4
	JZ TWOCIFR ;קשקןה ליûר 2 תמב‏.דיזע
	CPI 5
	JZ PUTWORD
	CPI 6
	JZ chHEIGHT ; ֵֽ־ֵֽׁ ׳Ù׃ֿװױ ׳Ù׳ִֹֽֿÙָ ׃ֹֽ׳ּֿֿ׳
	CPI 7
	JZ chCOLOR  ;ֵֽ־ֵֽׁ ֳ׳ֵװ ׳Ù׳ִֹֽֿÙָ׃ֹֽ׳ּֿֿ׳
	CPI 13
	JZ CRLF
	CPI 12
	JZ TABX
;////// ימב‏ו נעןףפן קשקןהים ףיםקןל /////////
	PUSH H
	LHLD CURSOR
	CALL PUTUCHAR
	LXI H,CURSOR+1
	INR M
	POP H
	JMP OUTINFO+1
INFEND:	PCHL
CURSOR:	DW 0
SETCURS:
	MOV A,M
	STA CURSOR
	INX H
	MOV A,M
	STA CURSOR+1
	INX H
	JMP OUTINFO+1
HEXOUT:
	MOV A,M
	INX H
	PUSH H
	CALL $+7
	POP H
	JMP OUTINFO+1
	PUSH PSW
	RRC
	RRC
	RRC
	RRC
	CALL $+4
	POP PSW
	ANI 0FH
	ADI 90H
	DAA
	ACI 40H
	DAA
	LHLD CURSOR
	CALL PUTUCHAR
	INR H
	SHLD CURSOR
	RET
TWOCIFR:
	MOV A,M
	PUSH H
	MOV L,A
	MVI H,0
	CALL tBYTE
	POP H
	INX H
	JMP OUTINFO+1
TABX:	LDA CURSOR+1
	ADD M
	STA CURSOR+1
	INX H
	JMP OUTINFO+1

chHEIGHT:
	MOV A,M
	STA HEIGHT
	INX H
	JMP OUTINFO+1
chCOLOR:
	MOV A,M
	CALL CHARCOLOR
	INX H
	JMP OUTINFO+1
CRLF:	PUSH H
	LHLD CURSOR
	MVI H,0
	INR L
	SHLD CURSOR
	POP H
	JMP OUTINFO+1
;//////// ׳Ù׳ִֿ ׃ּֿ׳ֱ ׳ 10-װֹÞ־ֿÊ ׃ֹ׃װֵֵֽ /////////
PUTWORD:
	MOV E,M
	INX H
	MOV D,M
	INX H
	PUSH H
	XCHG
	CALL SETCIF
	POP H
	JMP OUTINFO+1
SETCIF:	LXI B,-10000
	CALL PUTCIF
	LXI B,-1000
	CALL PUTCIF
sBYTE:
	LXI B,-100
	CALL PUTCIF
tBYTE:	LXI B,-10
	CALL PUTCIF
	MOV A,L
	JMP OUTC2
PUTCIF:	MVI E,255
	INR E
	DAD B
	JC $-2
	MOV A,L
	SUB C
	MOV L,A
	MOV A,H
	SBB B
	MOV H,A
	MOV A,E
OUTC2:	ADI 30H
	PUSH H
	LHLD CURSOR
	CALL PUTUCHAR
	LXI H,CURSOR+1
	INR M
	POP H
	RET
PUTBYTE:
	MOV A,M
	INX H
	PUSH H
	MOV L,A
	MVI H,0
	CALL sBYTE
	POP H
	JMP OUTINFO+1

PUTSTRING:
;קשקןה ףפעןכי ASCIIZ,  DE - ADDRR, HL-CURSOR
	LOCAL PUTST0,PUTST1
	PUSH H
	PUSH PSW
PUTST0:
	LDAX D
	ORA A
	INX D
	JZ PUTST1 ;FIN OF STRING
	CALL PUTUCHAR ;CHAR OUT
	INR H
	MVI A,1FH
	ANA H
	JNZ PUTST0
	MOV H,A ; H=0
	INR L   ; NEXT STRING
	JMP PUTST0
PUTST1:	POP PSW
	POP H
	RET

	ENDM
; תהוףר וףפר כןמוד םבכען *CHAR*
BOLDCHAR	MACRO
; קשקןה ףיםקןלב פןל‎ימןך הקב תמבכןםוףפב
; י הלימןך פצ 2 תמבכןםוףפב
BOLDSTRING:
;קטןה:  DE- ADDRRESS OF STRING ASCIIZ
;	HL- CURSOR X,Y RESPECT. 0-1FH
	LOCAL DBLS1,DBLS2
	LDAX D
	INX D
	ORA A
	RZ
	CALL DBLSYM
	INR H
	INR H
	MOV A,H
	CPI 1FH
	JC BOLDSTRING
	MVI H,0
	INR L
	INR L
	JMP BOLDSTRING

;  קשקןה פןלףפןחן ףיםקןלב
;  קטןה:  ב - כןה, HL - כץעףןע
DBLSYM:
	PUSHA
	PUSH H
	MOV L,A
	MVI H,0
	DAD H
	DAD H
	DAD H
	LXI D,TABLSYM
	DAD D
	XCHG
	POP H
DBLPLANE: ; +1 - נלןףכןףפר, יףנ.הלס קשקןהב ףיםקןלב
	MVI A,80H
	ORA H
	MOV H,A
	MOV A,L
	ADD A
	ADD A
	ADD A
	CMA
	MOV L,A
	MVI A,8
DBLS1:
	PUSH PSW
	LXI  B,0
	LDAX D
	PUSH D
	MVI D,8 ;BIT COUNTER
DBLS2:	RLC
	PUSH PSW
	ROL C
	ROL B
	POP PSW
	MOV E,A
	ROL C
	ROL B
	MOV A,E
	DCR D
	JNZ DBLS2
	REPT 2
	MOV M,B
	INR H
	MOV M,C
	DCR H
	DCR L
	ENDM
	POP D
	INX D
	POP PSW
	DCR A
	JNZ DBLS1
	POPA
	RET
	ENDM
;////כןמוד םבכעב BOLDCHAR////
	
;
;  INPUT.LIB - גֲֹֹּֿװֱֵֻ ׳׳ֱִֿ ֹ ׀ֱֲֵֿׂׂÚֿ׳ֱ־ֹׁ ֹ־ֱֳֶֹֹֽֿׂ
;   װֲֵׂױֵװ: APINIT.LIB, GRAPH.LIB, MATH.LIB
; ׳ְֻּÞֱֵװ ׳ ׃ֲֵׁ ־ֱ 4 ׁ־׳ֱׁׂ 2000ׂט :
;  mINPUT - קקןה ףפעןכי ק גץזוע
;  mDECI  - ׀ֱֲֵֿׂׂÚֿ׳ֱ־ֹׁ ׃װֹֻֿׂ ֳֶֹׂ ֹÚ ֲױֱֵֶׂ ׳
;	    ִֵ׃ׁװֹÞ־ֵֿ Þֹ׃ּֿ

mINPUT MACRO
; ׳ִָֿ: DE - ֱִֵׂ׃ ׃װֹֻֿׂ, HL - ֻױׂ׃ֿׂ(0-31)
;       B - ֱֻֽ׃ֱֹּֽ״־ֱסׁ ִֹּ־ֱ ׃װֹֻֿׂ, ף - ֳ׳ֵװ
;       A - װֵֻױÝֵֵ ׀ּֿֿײֵ־ֵֹ ֻױׂ׃ֱֿׂ
	LOCAL INP00,INP0,INP1,INP2,INP20,INP30
	LOCAL INP3,INP4,INP5,INP6,INP7,INP60
	LOCAL INP61,INP31,INP51
	LOCAL PRINTIT,PUTCUR,DELCUR,PRI0
INP00:	STA TIMCUR
INP0:	CALL PRINTIT
	CALL PUTCUR
	LPAUSE
	HLT
	HLT
	HLT
	WAITKEY
	PUSH PSW
	CALL DELCUR
	IN 1
	ANI 40H
	JNZ $+6
	POP PSW
	STC  ; ׀ֹׂÚ־ֱֻ ־ֱײֱװֿÊ ץף
	RET

	POP PSW

	CPI DOM
	JNZ $+7
	XRA A
	JMP INP00
	CPI RIGHT
	JNZ INP1
	LDA TIMCUR
	INR A
	CMP B
	JNC INP0
	JMP INP00
INP1:	CPI LEFT
	JNZ INP2
	LDA TIMCUR
	DCR A
	JM INP0
	JMP INP00
INP2:	CPI ZB
	JNZ INP3
	LDA TIMCUR
	DCR A
	JM INP0
	STA TIMCUR
	PUSHA
	MOV C,A
	ADD E
	MOV E,A
	JNC $+4
	INR D
	MOV H,D
	MOV L,E
	MOV A,B
	SUB C
	DCR A
	MOV C,A
INP20:	INX D
	LDAX D
	MOV M,A
	INX H
	DCR C
	JNZ INP20
	MVI M,20H
	POPA
	JMP INP0
INP3:	CPI F2
	JNZ INP4
	LDA TIMCUR
	PUSHA
	MOV C,A
	ADDDE
	XCHG
	MVI M,20H
	MOV A,C
	INR A
	SUB B
	JNC INP31    ; ׳׃ֵ, ֵ׃ֹּ ׀ֿ׃ִֵּ־ֹÊ ׃ֹֽ׳ּֿ
	CMA
	INR A
	MOV D,H
	MOV E,L
	MOV B,A
INP30:	INX D
	LDAX D
	MOV M,A
	INX H
	DCR B
	JNZ INP30
	MVI M,20H
INP31:	POPA
	JMP INP0
INP4:	CPI STR
	JNZ $+14
	LDA KEYPAD
	XRI 1
	STA KEYPAD
	JMP INP0
	CPI F5
	JNZ $+14
	LDA KEYPAD
	XRI 4
	STA KEYPAD
	JMP INP0

	CPI 40H  ; SPACE BAR?
	JNZ INP5
	MVI A,20H
	JMP INP6
INP5:	CPI 11H
	CMC
	RNC
	ADI 31  ; TRANSFORM CODE INTO ASCII (0-@,A-Z)
	CPI 64  ; ׳Ùֱֲֵֹֽׂ ׃ֱׂÚױ '0'-'?'
	JC INP51
	PUSH B
	MOV C,A
	LDA KEYPAD
	ANI 4   ; ׳Ùִֵֵּֽׁ d2
	MOV A,C
	POP B
	JZ $+5 ; גןלרûיו גץכקש (כבכ üפי)
	ADI 32
	PUSH B
	MOV C,A
	LDA KEYPAD
	ANI 2
	MOV A,C
	POP B
	JZ INP6
	ORI 80H
INP6:	PUSHA
	MOV C,A
	LDA KEYPAD
	RRC
	LDA TIMCUR
	JC INP7

	MOV H,D
	MOV L,E  ; HL = DE
	PUSH PSW
	ADDHL
	POP PSW
	INR A
	CMP B
	JNC INP60
	STA TIMCUR
	SUB B
	CMA
	INR A
	PUSH PSW
	MOV A,B
	ADDDE
	DCX D
	MOV H,D
	MOV L,E
	POP PSW
	MOV B,A
INP61:	DCX D
	LDAX D
	MOV M,A
	DCX H
	DCR B
	JNZ INP61
INP60:	MOV M,C
	POPA
	JMP INP0
INP7:	MOV L,A
	ADDDE
	MOV A,C
	STAX D
	MOV A,L
	POPA
	INR A
	CMP B
	JNC INP0
	JMP  INP00
INP51:	PUSH B
	MOV C,A
	IN 1
	ANI 20H ; CC IST?
	MOV A,C
	POP B
	JNZ INP6
	SUI 16
	JMP INP6
	
TIMCUR:	DB 0   ; װֵֻױÝֵֵ ׀ּֿֿײֵ־ֵֹ ֻױׂ׃ֱֿׂ ׳ ֱִֵֻׂװֹׂױֵֽֿÊ
	       ; ׃װֵֻֿׂ

PRINTIT:
	PUSHA
	MOV A,C
	CALL CHARCOLOR
PRI0:	LDAX D
	CALL PUTUCHAR
	INR H
	INX D
	DCR B
	JNZ PRI0
	POPA
	RET
PUTCUR:
	MVI A,10H
	JMP $+4
DELCUR:	XRA A	
	PUSHA
	ORA C
	CALL CHARCOLOR
	LDA TIMCUR
	MOV C,A
	ADD H
	MOV H,A
	MOV A,C
	ADDDE
	LDAX D
	CALL PUTUCHAR ;קשקןה ףיםקןלב ית GRAPH.LIB
	POPA
	RET
	ENDM

DECI MACRO BUFFER
; ׳ִָֿ- DE - ֱִֵׂ׃ ֲױֱֵֶׂ ִּׁ ׳ִָֿ־ַֿֿ ׀ֱֲֵֿׂׂÚֿ׳ֱ־ֹׁ
; ׳Ùִָֿ - DE - ִֵ׃ׁװֹÞ־ֵֿ, ֱֽװ״ ֵַֿ, Þֹ׃ּֿ
	LOCAL DECI0,DECEND
	JMP DECEND
@DECI:	LXI H,0
	XCHG
DECI0:	MOV A,M
	INX H
	SUI 30H
	RC   ;‏יףלב 80H+30H+10  פןצו םןחץפ
	CPI 10  ; מבטןהיפרףס ק ליףפימחו
	RNC     ;üפן קבם מו  כןי-7
	MOV C,A
	MVI B,0
	PUSH H
	MOV H,D
	MOV L,E
	DAD H
	DAD H
	DAD D
	DAD H
	DAD B
	XCHG
	POP H
	JMP DECI0
DECEND:
DECI	MACRO ?BUFFER
	IF NOT NUL ?BUFFER
	LXI D,?BUFFER
	ENDIF
	CALL @DECI
	ENDM
	DECI BUFFER
	ENDM

HEXI	MACRO BUFFER
;פן צו הולבום הלס ûוףפמבהדבפיעי‏מןחן נעוןגעבתןקבמיס
	LOCAL @HEXIEND,@HEXI1,@HOKEY
	JMP @HEXIEND
@HEXI:
	LXI H,0
	MOV B,L
@HEXI1:
	XCHG
	MOV A,M
	INX H
	SUI 30H
	RC
	CPI 10
	JC @HOKAY
	SUI 7 ;FOR 'A'-'F'
	CPI 10
	RC
	CPI 10H
	RNC
@HOKAY:	MOV C,A
	XCHG
	DAD H
	DAD H ;*4
	DAD H
	DAD H ;*10H
	DAD B ;+BC
	JMP @HEXI1
@HEXIEND:
HEXI	MACRO ?BUFFER
	IF NOT NUL ?BUFFER
	LXI D,?BUFFER
	ENDIF
	CALL @HEXI
	ENDM
	HEXI BUFFER
	ENDM

BYNI	MACRO BUFFER
;הלס נןלמןפש ןניףבמיס מו טקבפבופ
;ליûר OCTI, מן וו ףהולבפר נען‎ו,
; ‏ום קףו ןףפבלרמשו
; 1.נעןקועיפר קשטןה תב ףיםקןל '0'-'7'
; 2.נעוןגעבתןקבפר ק ‏יףלן 0-7
; 3.ץםמןציפר עותץלרפבפ מב 8 י נעיגבקיפר
;   קקוהוממןו ף גץזועב ‏יףלן
; 4.נןקפןעספר נןכב מו כןמוד ‏יףלב ק גץזועו
;
	LOCAL @BYNEND,@BYN1
	JMP @BYNEND
@BYNI:
	LXI H,0
@BYN1:	XCHG
	MOV A,M
	INX H
	SUI 30H
	RC
	CPI 2
	RNC
	XCHG
	DAD H
	ORA L
	MOV L,A
	JMP @BYN1
@BYNEND:
BYNI	MACRO ?BUFFER
	IF NOT NUL ?BUFFER
	LXI D,?BUFFER
	ENDIF
	CALL @BYNI
	ENDM
	BYNI BUFFER
	ENDM

; MATH.INC 
;

LDIR MACRO FROM,TO,HOWMUCH
	LOCAL LDIREND
	JMP LDIREND
mLDIR:
	PUSH PSW
	MOV A,M
	STAX D
	INX H
	INX D
	DCX B
	MOV A,B
	ORA C
	JNZ mLDIR+1
	POP PSW
	RET
LDIREND:
LDIR	MACRO ?FROM,?TO,?HOWMUCH
	IF NOT NUL ?FROM
	LXI H,?FROM
	ENDIF
	IF NOT NUL ?TO
	LXI D,?TO
	ENDIF
	IF NOT NUL ?HOWMUCH
	LXI B,?HOWMUCH
	ENDIF
	CALL mLDIR
	ENDM
	LDIR FROM,TO,HOWMUCH	
	ENDM

XDIR MACRO FROM,TO,HOWMUCH
	LOCAL @XDIREND
	JMP @XDIREND
@XDIR:	PUSH PSW
	MOV A,M
	PUSH PSW
	  LDAX D
	  MOV M,A
	POP PSW
	STAX D
	INX H
	INX D
	DCX B
	MOV A,B
	ORA C
	JNZ @XDIR+1
	POP PSW
	RET
@XDIREND:	
XDIR	MACRO ?FROM,?TO,?HOWMUCH
	IF NOT NUL ?FROM
	LXI H,?FROM
	ENDIF
	IF NOT NUL ?TO
	LXI D,?TO
	ENDIF
	IF NOT NUL ?HOWMUCH
	LXI B,?HOWMUCH
	ENDIF
	CALL @XDIR
	ENDM
	XDIR FROM,TO,HOWMUCH
	ENDM
ADDHL MACRO
	ADD L
	MOV L,A
	JNC $+4
	INR H
	ENDM
ADDDE MACRO
	ADD E
	MOV E,A
	JNC $+4
	INR D
	ENDM
SUBHB MACRO
	MOV A,L
	SUB C
	MOV L,A
	MOV A,H
	SBB B
	MOV H,A
	ENDM
SUBHD MACRO
	MOV A,L
	SUB E
	MOV L,A
	MOV A,H
	SBB D
	MOV H,A
	ENDM
CMPHD MACRO
	MOV A,H
	CMP D
	JNZ $+5
	MOV A,L
	CMP E
	ENDM

RND	MACRO REG
	LOCAL MASRND,pMASRND,@RNDEND
	JMP @RNDEND
@RND:	PUSH H
	PUSH B
	LXI H,MASRND
	LDA pMASRND
	MOV C,A
	ADI 13
	ANI 1FH
	STA pMASRND
	ADDHL
	MOV A,C
	MOV C,M
	LXI H,MASRND
	ADDHL
	MOV A,M
	ADD C
	ACI 1
	MOV M,A
	POP B
	POP H
	RET
pMASRND:
	DB 0
MASRND:
	DS 20H
@RNDEND:
RND	MACRO ?REG
	CALL @RND
	IF NOT NUL ?REG
	MOV ?REG,A
	ENDIF
	ENDM
	RND REG
	ENDM


ROL	MACRO REG
;SHIFT LEFT REG WITH CY
	MOV A,REG
	RAL
	MOV REG,A
	ENDM
ROR	MACRO REG
;SHIFT RIGHT REG  WITH CY
	MOV A,REG
	RAR
	MOV REG,A	
	ENDM
XLAT	MACRO REG
;קשגןעכב ית פבגלידש [HL+A]
	ADDHL
	IF NUL REG
	MOV A,M
	ELSE
	MOV REG,M
	ENDIF
	ENDM
LODSB	MACRO REG
	LDAX D
	INX D
	IF NOT NUL REG
	MOV REG,A
	ENDIF
	ENDM
STOSB	MACRO REG
	IF NUL REG
	MOV M,A
	ELSE
	MOV M,REG
	ENDIF
	INX H
	ENDM
MOVSB	MACRO
;[DE]->[HL] ף ימכעוםומפןם
	LDAX D
	MOV M,A
	INX D
	INX H
	ENDM


MULTIDIV MACRO
MULT:
	LOCAL MULT1
	LXI H,0 ;AHL = DE*A
	MVI B,8
MULT1:	DAD H
	RAL
	JNC $+6
	DAD D
	ACI 0
	DCR B
	JNZ MULT1
	RET

DIVAC:
;	WARNING!!!!!!!!
; IF C=0 - ETERNAL CYCLE
	MVI B,255 ;A=A/C
	INR B
	SUB C
	JNC $-2
	ADD C
	MOV C,A
	MOV A,B
	RET

MULTCD:
	LOCAL MCD0
	MVI B,0
	MVI E,9
MCD0:	ROR C
	DCR E
	RZ
	MOV A,B
	JNC $+4
	ADD D
	RAR
	MOV B,A
	JMP MCD0

DIVBCA:
	LOCAL DBCA0
	PUSH H
	CMA
	INR A
	MOV E,A
	MVI D,-1
	LXI H,0
	MVI A,17
DBCA0:	PUSH H
	DAD D
	JNC $+4
	XTHL
	POP H
	PUSH PSW
	ROL C
	ROL B
	ROL L
	ROL H
	POP PSW
	DCR A
	JNZ DBCA0
;
	ORA A
	MOV A,H
	RAR
	MOV D,A
	MOV A,L
	RAR
	MOV E,A
	POP H
	RET
	ENDM

; זבךל 	MUSIC.LIB
; מב‏בל עבגןפבפר מבה זבךלןם נןלנועקןחן מן‏י
;   11 סמקבעס 2000 חןהב ןפ  עןצהוףפקב
;     חןףנןהמוחן. בםימר!!

; MACRO FOR KILLING ALL CHANNELS
ALLSOUNDOFF MACRO
	CALL CHAN1OFF
	CALL CHAN2OFF
	CALL CHAN3OFF
	ENDM
STARTPLAY MACRO ADDR1,ADDR2,ADDR3
;קכלא‏ומיו כבמבלןק נן ץכבתבמ.בהעוףבם
	IF NOT NUL ADDR1
	LXI H,ADDR1
	CALL CHAN1ON
	ENDIF
	IF NOT NUL ADDR2
	LXI H,ADDR2
	CALL CHAN2ON
	ENDIF
	IF NOT NUL ADDR3
	LXI H,ADDR3
	CALL CHAN3ON
	ENDIF
	ENDM
STOPPLAY MACRO NUMCHAN
;קשכלא‏ומיו כבמבלןק
;זןעםבפ קשתןקב:
;	STOPPLAY - קשכלא‏ומיו קףוט כבמבלןק
;	STOPPLAY <1,3> -קשכלא‏ומיו 1 י 3 כבמבלןק
;	STOPPLAY 3     -קשכלא‏ומיו 3 כבמבלב
	IF NUL NUMCHAN
	CALL CHAN1OFF
	CALL CHAN2OFF
	CALL CHAN3OFF
	ELSE
	IRP CH,<NUMCHAN> ;נןקפןעיפר הלס  תבהבממןחן כבמבלב
	CALL CHAN&CH&OFF
	ENDM
	ENDIF
	ENDM
;

 
; ב פונוער ןףמןקמןך םבכעןף!
MUSIC MACRO
YCHAN1:	DB 0
YCHAN2:	DB 0
YCHAN3:	DB 0
YNOTE1:	DB 0  ; NOTE PLAYING OR FREE
YNOTE2:	DB 0  ; 1-FREE,128-PLAYING,255-PAUSE
YNOTE3:	DB 0  ; 0,129-254 IS RESERVED
ADDRNOTE1:
	DW 0  ; ADDRESS CURRENT NOTE
ADDRNOTE2:
	DW 0
ADDRNOTE3:
	DW 0
BEGNOTE1:
	DW 0   ; ADDRESS OF START MELODY
BEGNOTE2:
	DW 0
BEGNOTE3:
	DW 0

OCTAVE1:
	DB 0  ; OCTAVE ('0'-'6')
OCTAVE2:
	DB 0
OCTAVE3:
	DB 0
LENGTH1:
	DB 0   ; LENGTH ('1'-DB 255)
LENGTH2:
	DB 0
LENGTH3:
	DB 0
WAVE1:
	DB 0     ; WAVE OF NOTE
WAVE2:
	DB 0
WAVE3:
	DB 0
ABSNOTE1:
	DW 0  ; ABSOLUTE NOTE
ABSNOTE2:
	DW 0
ABSNOTE3:
	DW 0
; עוציםש 0-נעןףפןך תקץכ, 1-נלבקבא‎יך
; מןםועב 2-255 תבעותועקיעןקבמש
; נלבמיעץופףס :2-קןתעבףפבמיו מןפש,3-נבהומיו מןפש
;		4-קתעשק מןפש (gDw)

MODE1:	DB 0
MODE2:	DB 0
MODE3:	DB 0

;
; בגףןלאפמשו תמב‏ומיס מןפ:
;
DO:	DW 45872
	DB 98H,59H,0CBH,2CH,66H,16H,33H,0BH
	DW 1433,717
DODIEZ:	DW 43290
	DB 90H,54H,47H,2AH,24H,15H,92H,0AH
	DW 1353,677
RE:	DW 40872
	DB 0D1H,4FH,0E8H,27H,0F4H,13H,0FAH,9
	DW 1277,639
REDIEZ:	DW 38560
	DW 4B55H,25ABH,12D5H,96BH
	DW 1205,602
MI:	DW 36408
	DW 471CH,238DH,11C7H,8E3H
	DW 1137,569
FA:	DW 34364
	DW 431EH,218FH,10C7H,863H
	DW 1074,537
FADIEZ:	DW 32432
	DW 3F5AH,1FADH,0FD6H,7EBH
	DW 1014,507
SOL:	DW 30612
	DW 3BCCH,1DE5H,0EF3H,779H
	DW 957,472
SOLDIEZ:
	DW 28902
	DW 3870H,1C38H,0E1CH,70EH
	DW 904,452
LA:	DW 27273
	DW 3544H,1AA2H,0D51H,6A9H
	DW 852,426
SIBEMOL:
	DW 25729
	DW 3247H,1924H,0D22H,649H
	DW 804,402
SI:	DW 24311
	DW 2F75H,17BAH,0BDDH,5EFH
	DW 759,380

;בהעוףב מןפ ק נבםספי
NOTES:	DW LA,SI,DO,RE,MI,FA,SOL
	DW DODIEZ,REDIEZ,FADIEZ,SOLDIEZ,SIBEMOL

SETADDRNOTE: ;SET IN BC ADDRESS NOTE IN A
	SUI 'A'
	ADD A
	LXI B,NOTES
	MOV L,A
	MVI H,0
	DAD B
	MOV C,M
	INX H
	MOV B,M
	RET

;
; START OF MAIN PROGRAM
;
PLAY1CHAN:
	LDA YNOTE1
	ORA A
	JM PLAY1NOTE
	MVI A,36H
	OUT 8
	LHLD ADDRNOTE1
P1C0X:	MOV B,M
	INX H
	MOV A,M
	STA OCTAVE1
	INX H
	MOV A,M
	STA LENGTH1
	INX H
	SHLD ADDRNOTE1
	MVI A,128
	STA YNOTE1
	MVI A,6
	STA WAVE1
	MOV A,B
	CPI 24H   ; כמד םלה1.../
	JZ CHAN1OFF
	CPI 'R'   ; נןקפןע?
	JZ FIRSTMELO1
	CPI 'P'     ;נבץתב?
	JZ SET1PAUSE
	CPI 'M'
	JZ SET1MODE ;ףםומב עוציםב
	CPI 'X'
	JZ SET1DRUM ;גבעבגבמש
	CALL SETADDRNOTE
P1C0:	LDA OCTAVE1
P1C1:	CPI 30H
	JZ P1C2
	INX B
	INX B
	DCR A
	JMP P1C1

P1C2:	LDAX B
	MOV L,A
	INX B
	LDAX B
	MOV H,A
	SHLD ABSNOTE1
	XRA A
	JMP PLAY1NOTE

PLAY2CHAN:
	LDA YNOTE2
	ORA A
	JM PLAY2NOTE
	MVI A,76H  ; קשכל/קכל 1-שך כבמבל
	OUT 8
	LHLD ADDRNOTE2
P2C0X:	MOV B,M
	INX H
	MOV A,M
	STA OCTAVE2
	INX H
	MOV A,M
	STA LENGTH2
	INX H
	SHLD ADDRNOTE2
	MVI A,128
	STA YNOTE2
	MVI A,6
	STA WAVE2
	MOV A,B
	CPI 'R'
	JZ FIRST2MELO
	CPI '$'
	JZ CHAN2OFF
	CPI 'P'
	JZ SET2PAUSE
	CPI 'M'
	JZ SET2MODE
	CALL SETADDRNOTE
P2C0:	LDA OCTAVE2
	CPI 30H
	JZ P2C2
	INX B
	INX B
	DCR A
	JMP P2C0+3
P2C2:	LDAX B
	MOV L,A
	INX B
	LDAX B
	MOV H,A
	SHLD ABSNOTE2
	XRA A
	JMP PLAY2NOTE

PLAY3CHAN:
	LDA YNOTE3
	ORA A
	JM PLAY3NOTE
	MVI A,0B6H  ; קכל/קשכל 2-ןך כבמבל
	OUT 8
	LHLD ADDRNOTE3
P3C0X:	MOV B,M
	INX H
	MOV A,M
	STA OCTAVE3
	INX H
	MOV A,M
	STA LENGTH3
	INX H
	SHLD ADDRNOTE3
	MVI A,128
	STA YNOTE3
	MVI A,6
	STA WAVE3
	MOV A,B
	CPI 'R'
	JZ FIRST3MELO
	CPI '$'
	JZ CHAN3OFF
	CPI 'P'
	JZ SET3PAUSE
	CPI 'M'
	JZ SET3MODE
	CALL SETADDRNOTE
P3C0:	LDA OCTAVE3
	CPI 30H
	JZ P3C2
	INX B
	INX B
	DCR A
	JMP P3C0+3
P3C2:	LDAX B
	MOV L,A  ;LOW BYTE GOES FIRST
	INX B
	LDAX B
	MOV H,A  ;HIGH ONE GOES AFTER
	SHLD ABSNOTE3
	XRA A
	JMP PLAY3NOTE

;ןגעבגןפכב מןפ תבכןמ‏ילבףר, פונוער מב‏בלבףר/////
; ףבםב יחעב מןפ ילי נבץתב///////////////////////
PLAY1NOTE:
	CPI 129
	JZ PLAY1DRUM
	LDA WAVE1
	DCR A
	STA WAVE1
	MOV B,A
	LHLD ABSNOTE1
	LDA MODE1
	ORA A
	JZ P1C6
	MOV A,B
	LXI B,28H
	CPI 3
	JNC P1C5
	LXI B,-28H
P1C5:	DAD B
	SHLD ABSNOTE1
P1C6:	LDA YNOTE1
	INR A
	JZ @NO1PLAY
	MOV A,L
P1C7:	OUT 0BH ; SOUND
	MOV A,H
	OUT 0BH
@NO1PLAY:
	LXI H,WAVE1
	XRA A
	ORA M
	RNZ
	MVI M,6
	LDA LENGTH1
	DCR A
	STA LENGTH1
	SUI 30H
	RNZ
	STA YNOTE1 ; PLAY NEXT NOTE
	RET
PLAY2NOTE:
	LXI H,WAVE2
	DCR M
	MOV B,M
	LDA MODE2
	ORA A
	LHLD ABSNOTE2
	JZ P2C6
	MOV A,B
	LXI B,28H
	CPI 3
	JNC P2C5
	LXI B,-28H
P2C5:	DAD B
	SHLD ABSNOTE2
P2C6:	LDA YNOTE2
	INR A
	JZ @NO2PLAY
	MOV A,L
P2C7:	OUT 0AH
	MOV A,H
	OUT 0AH
@NO2PLAY:
	LXI H,WAVE2
	XRA A
	CMP M
	RNZ
	MVI M,6
	LXI H,LENGTH2
	DCR M
	MOV A,M
	SUI 30H
	RNZ
	STA YNOTE2
	RET

PLAY3NOTE:
	LXI H,WAVE3
	DCR M
	MOV B,M
	LHLD ABSNOTE3
	LDA MODE3
	ORA A
	JZ P3C6
	MOV A,B
	LXI B,28H
	CPI 3
	JNC P3C5
	LXI B,-28H
P3C5:	DAD B
	SHLD ABSNOTE3
P3C6:	LDA YNOTE3
	INR A
	JZ @NO3PLAY
	MOV A,L
P3C7:	OUT 9
	MOV A,H
	OUT 9
@NO3PLAY:
	LXI H,WAVE3
	XRA A
	ORA M
	RNZ
	MVI M,6
	LXI H,LENGTH3
	DCR M
	MOV A,M
	CPI 30H
	RNZ
	MVI A,1      ; מןפב ןףקןגןהילבףר!
	STA YNOTE3
	RET

; ןפכלא‏ומיו  כבמבלןק
CHAN1OFF:
	XRA A
	STA YCHAN1
	MVI A,36H
	OUT 8
	RET
CHAN2OFF:
	XRA A
	STA YCHAN2
	MVI A,76H
	OUT 8
	RET
CHAN3OFF:
	XRA A
	STA YCHAN3
	MVI A,0B6H
	OUT 8
	RET

; מב‏בלב םולןהיך י קכלא‏ומיו כבמבלןק
FIRSTMELO1:
	LHLD BEGNOTE1
CHAN1ON:
	MVI A,1
	STA YCHAN1
	STA YNOTE1
	SHLD BEGNOTE1
	SHLD ADDRNOTE1
	RET

FIRST2MELO:
	LHLD BEGNOTE2
CHAN2ON:
	MVI A,1
	STA YCHAN2
	STA YNOTE2
	SHLD BEGNOTE2
	SHLD ADDRNOTE2
	RET

