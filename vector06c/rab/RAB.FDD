SET1PAUSE:
	MVI A,255
	STA YNOTE1
	JMP P1C2 ; נעןהןלצומו ןגעבגןפכי	
SET2PAUSE:
	MVI A,255
	STA YNOTE2
	JMP P2C2
SET3PAUSE:
	MVI A,-1
	STA YNOTE3
	JMP P3C2
