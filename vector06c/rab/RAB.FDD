START:DI
LHLD 39H
SHLD OLD39H
LXI H,INIT
SHLD 39H
XRA A
OUT 10H
LXI SP,100H
EI
JMP PROGRM

OLD39H:DW 0
KEY:DB 0
SCROLL:DB 0FFH
BORDER:DB 0

INIT:PUSH H
PUSH D
PUSH B
PUSH PSW
MVI A,88H
OUT 0
LXI H,COLOR15
LXI D,100FH
INIT1:MOV A,E
OUT 2
MOV A,M
OUT 0FH
OUT 0FH
OUT 0FH
OUT 0FH
DCX H
OUT 0FH
DCR E
DCR D
OUT 0FH
JNZ INIT1
MVI A,8AH
OUT 0
MVI A,0FEH
OUT 3
IN 2
STA KEY
MVI A,88H
OUT 0
LDA BORDER
