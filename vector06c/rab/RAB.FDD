MACLIB GRAPH1
MACLIB INPUT

STARTPROGRAM	EQU 8300H
MyVALUE 	EQU 83H+0
HBofT	EQU 90H

ORG 100H
DI
LXI SP,100H
LDA 39H
LXI H,3AH
ADD M
CPI MyVALUE
PUSH PSW
LDA 80H
CPI 10H
JNC @NOPARAM ;מופ נבעבםופעןק
ADI 81H
MOV L,A
MVI H,0
MVI M,13
MVI L,81H
MVI A,20H
CMP M
JNZ @OKAY
INX H
JMP $-5
@OKAY:XCHG
CALL DECI  ;נעוןגעבתץום נבעבםופע ק ‏יףלן ק ו
MOV A,E
CPI 22
JNC @NOPARAM
ORA E
JZ @NOPARAM
POP PSW
JNZ BEGINIT ;מב‏מום מב‏.ימידיבליתבדיא
LHLD OLD38H+1
SHLD 39H
JMP BEGINIT
@NOPARAM:
MVI E,5
POP PSW
JNZ BEGINIT
; ׳Ùַׂױײֱֵֽ׃ׁ ־ֱ ֵָׂ־, Þװֲֿ ־ֵ ׃ֱַּÚֹװ״
LHLD OLD38H+1
SHLD 39H
LXI H,STARTPROGRAM
LXI B,SIZEOFPROGRAM
MVI E,0
MOV M,E
INX H
DCX B
MOV A,B
ORA C
JNZ $-5
EI
LXI D,MY2STR
MVI C,9
CALL 5
RST 0   ; ׳Ùִָֹֽֿ ׳ CP/M
MY2STR:DB 1BH,5CH,0EH
DB 'נעןחעבםםב קשחעץצומב!',0FH,'$'
DB 'by GDW',0


BEGINIT: ;/////////// ־ֱÞֱּ״־ֱׁ ֹ־ֱֳֹֹֹּÚֱֳֹׁ///
PUSH D
MOV A,E  ; ק ב-נבעבםופע ק ףוכץמהבט
LXI D,3000
CALL MULT
PUSH H
LXI H,BODYOFPROGRAM
LXI D,STARTPROGRAM
LXI B,SIZEOFPROGRAM
CALL LDIR  ; נועומוףום פולן נעןחי ק ףקןגןהמץא  ןגל.
POP H
SHLD COUNTER
LHLD 39H
SHLD OLD38H+1 ; ־ֿ׳Ê INIT!
LXI H,STARTPROGRAM
SHLD 39H
LXI D,MYSTRING
POP H
MOV A,L
CALL DECO ;ףוכץמהש נעןגעבתץום ק ףפעןכץ
MVI B,'ב'
CPI 1
JZ BEG1
CPI 21
JZ BEG1
MVI B,'ש'
CPI 5
JC BEG1
MVI B,32
BEG1:MOV A,B
STA eMYSTRING
MVI C,9
CALL  5
RST 0

MYSTRING:DB 1BH,5CH,0EH,'קעוםס - '
dMYSTRING:DB ' 1 םימץפ'
eMYSTRING: DB ' ',0FH,13,10,'$'
DB 'by G_D_W'
DECO:PUSH PSW
CPI 10
LXI H,dMYSTRING
JC DECO1
MVI B,255
INR B
SUI 10
JNC $-3
MOV A,B
ANI 0FH
ORI 30H
MOV M,A
POP PSW
PUSH PSW
SUI 10
CPI 10
JC DECO1
SUI 10 ;םלבהûץא DEC-יזעץ נעוןגעבתץום
DECO1:	 ;נעבקבס דיזעב 0-9
INX H
ANI 0FH
ORI 30H
MOV M,A
POP PSW
RET
MULTIDIV
DECI:mDECI
LDIR:mLDIR

BODYOFPROGRAM:

ORG STARTPROGRAM
PUSHA 1 ; ׳׃ֵ ֵַֹׂ׃װׂÙ ֹ ֱֻֻױֽױּׁװֿׂ
MVI A,8AH
OUT 0
XRA A
OUT 3
IN 2
MOV B,A
MVI A,88H
OUT 0
INR B
JZ @NONAJ ; מופ מבצבפיס!
LDA REGIME
ORA A
JZ BDP2
MVI B,HBofT
MVI C,0
XRA A
OUT 10H
STA REGIME
BDP1:
LDAX B
MOV H,A
INR B
LDAX B
MOV L,A
INR B
LDAX B
CALL SETCOLOR
CALL PLOT
DCR B
DCR B ; קועמום ץכתבפולר
INR C
JNZ BDP1
MVI A,23H
OUT 10H
BDP2:LXI H,0
SHLD xCOUNTER

BDP20:POPA 1
OLD38H:JMP 0
COUNTER:DW 0 ; ןג‎יך ף‏ופ‏יכ
xCOUNTER:DW 0
REGIME:DB 0

;ֵ׃ֹּ ֱֻּ׳ֹÛֱ ־ֵ ־ֱײֱװֱ
@NONAJ:LDA REGIME
ORA A
JNZ BDPX ; קשקןהים פן‏כי
CALL RND  ;ימידיבל.ףלץ‏יףלב!
LHLD COUNTER
XCHG
LHLD xCOUNTER
INX H
CMPHD
JC BDP2+3
XRA A
OUT 10H
INR A
STA REGIME
MVI B,HBofT
MVI C,0
BDP3:CALL RND
STAX B
INR B
MOV H,A
CALL RND
STAX B
MOV L,A
INR B
CALL GETCOLOR
ANI 6
STAX B
DCR B
DCR B
INR  C
JNZ BDP3 ; 256 ס‏ווכ
MVI A,23H
OUT 10H
JMP BDP20 ; מב קשטןה!
; ֽֿײֵװ,ּױÞÛֵ ׃־ֱÞֱֱּ ֿװֱֲֿׂװֱװ״
; ֱ׀׀ֱֱׂװ־ֵֿ ׀ֵׂׂÙ׳ֱ־ֵֹ?
BDPX: ; עבגןפבופ REGIME=1
POPA 1
CALL OLD38H ;ֿװֱֲֿׂװֱֹּ
DI
PUSHA 1

XRA A
OUT 10H
CALL RND
CPI 60H
JC DELPIXEL
MVI E,3
BDPX0:SETPIXEL
DCR E
JNZ BDPX0
JMP BDPX1
DELPIXEL:MVI E,3
SETPIXEL 1 ; ץהבלים ןהמץ פן‏כץ
DCR E
JNZ DELPIXEL+2
BDPX1:
MVI A,23H
OUT 10H
POPA 1
EI
RET

DB 'GDW-9JAN2000aD-SUNDAY-1:40pm',0

RND:mRND
POINT

XEND:	DB 0 
; Üװֿ ֲÙֱּ ֵֽװֱֻ ֻֿ־ֱֳ ׀ַֹֿׂ ׳ ׀ֱֽׁװֹ!

SIZEOFPROGRAM EQU XEND-STARTPROGRAM

END

