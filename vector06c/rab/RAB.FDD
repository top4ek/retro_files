ORG 100H
START:DI
MVI A,0C3H
STA 38H
STA 0
LXI H,100H
SHLD 1
LXI H,INIT
SHLD 39H
XRA A
OUT 10H
OUT 3
LXI SP,7FFFH
EI
JMP PROGRM

KEY:DB 0
SCROLL:DB 0FFH
BORDER:DB 0

INIT:PUSH H
PUSH D
PUSH B
PUSH PSW
MVI A,88H
OUT 0
LXI H,COLOR15
LXI D,100FH
INIT1:MOV A,E
OUT 2
MOV A,M
OUT 0FH
OUT 0FH
OUT 0FH
OUT 0FH
DCX H
OUT 0FH
DCR E
DCR D
OUT 0FH
JNZ INIT1
MVI A,8AH
OUT 0
MVI A,0FEH
OUT 3
IN 2
STA KEY
MVI A,88H
OUT 0
LDA BORDER
OUT 2
LDA SCROLL
OUT 3
POP PSW
POP B
POP D
POP H
EI
RET
FOREST:DB 0,2BH,0ADH,8DH,30H,1BH,96H,0BDH,7,0C0H
DB 54H,3DH,0C2H,0E9H,64H
COLOR15:DB 4FH
CLS:LXI H,8000H
MVI M,0
INX H
MOV A,H
ORA A
JNZ CLS+3
RET
PROGRM:
CALL CLS
MVI A,15
CALL SETCOL
CALL LINE
JMP $

POPA MACRO
     POP H
     POP D
     POP B
     ENDM
PUSHA MACRO
      PUSH B
      PUSH D
      PUSH H
      ENDM


; ////////// קשקןה מב üכעבמ ///////////
PLOT:
PUSHA
MVI A,7
ANA H
LXI D,NumBit
ADD E
MOV E,A
JNC $+4
INR D
MOV A,H
RRC
RRC
RRC
ANI 1FH
ORI 80H
MOV H,A
MOV A,L
CMA
MOV L,A
LXI B,2000H
LDAX D
MOV D,A
NOP
ORA M
MOV M,A
REPT 2
	DAD B
	MOV A,D
	NOP
	ORA M
        MOV M,A
	ENDM
DAD B
MOV A,D
NOP
WHCOL:ORA M
MOV M,A
POPA
RET

NumBit:DB 80H,40H,20H,10H,8,4,2,1

SETCOL: ;ץףפבמןקכב דקופב הלס ףגש PLOT
PUSH D
PUSH H
PUSH PSW
MVI D,3
LXI H,WHCOL
SETC0:
	RRC
	JNC SETC1
	MVI M,0B6H
	DCX H
	MVI M,0
	JMP SETC2
SETC1:  MVI M,0A6H
	DCX H
	MVI M,2FH  ; 'CMA'
SETC2:  
REPT 4
	DCX H
	ENDM
DCR D
JP SETC0
POP PSW
POP H
POP D
RET

; //////////////  ׃ֱֱֲ ֹּ־ֹׁ ֵÝֵ ֽ־ֿÊ ־ֵ //////////
; /////////////  ֲÙֱּ ֿ׀ֲֹֿׂׂ׳ֱ־ֱ ֱׂ־ֵֵ, ׳ 1995 ִַֿױ ////

STY:DB 0
STX:DB 0
ENDY:DB 255
ENDX:DB 255
DIYIN:DB 0
DIXIN:DB 0
SHDI:DB 0
STXIN:DB 0
STYIN:DB 0
STCO:DB 0
DICO:DB 0

LINE:
;//////// לימיס,פבכ וס עבףפבכ!!! //////
MVI C,1
MOV D,C
LDA STY
MOV H,A
LDA ENDY
SUB H
MOV H,A
JNC KEEPY
MVI D,255
MOV A,H
CMA
INR A
MOV H,A
KEEPY:MOV A,D
STA DIYIN
LDA STX
MOV L,A
LDA ENDX
SUB L
MOV L,A
JNC KEEPX
MVI C,255
MOV A,L
CMA
INR A
MOV L,A
KEEPX:MOV A,C
STA DIXIN

MOV A,L
CMP H ; ַֹֿׂÚֿ־װֱּ״־Ùֵ ׃ֵֵַֽ־װÙ ִֹּ־־ֵֵ?
JNC HORS  ; Dב - כ טןעףץ
MVI C,0
MOV A,L
MOV L,H
MOV H,A
JMP $+5
HORS:MVI D,0
MOV A,H
STA SHDI
MOV A,C
STA STXIN
MOV A,D
STA STYIN
;///////// ׳ÙÞֹ׃ֵּֽׁ ׳Ùֱׂ׳־ֹ׳ְֱÝֹÊ ֵַֿ ֱֽװ״ ֱֶֻװֿׂ /////
LDA SHDI
ANA A
RAL
STA STCO
SUB L
MOV B,A
SUB L
STA DICO
;////// ׀ִַֿֿװֿ׳ֱֻ ֻ ׳Ù׳ִֿױ ֹּ־ֹֹ ///////////
LDA STX
MOV C,A
LDA STY
MOV D,A
INR L
;/// װֵ׀ֵׂ״ ׳Ù׳ִֹֽֿ ׃ֱֽױ ֹּ־ְֹ /////////
line1:
DCR L
RZ
PUSH H
MOV H,C ; X -> H
MOV L,D ; Y -> L
CALL PLOT
POP H
MOV A,B
ORA A
JP DILIN
LDA STXIN
ADD C
MOV C,A
LDA STYIN
ADD D
MOV D,A
LDA STCO
ADD B
MOV B,A
JMP LINE1
DILIN: ;//// ֱִַֹֿ־ֱּ״־Ùֵ ׃ֵֵַֽ־װÙ //////////
LDA DIXIN
ADD C
MOV C,A
LDA DIYIN
ADD D
MOV D,A
LDA DICO
ADD B
MOV B,A
JMP LINE1
;//////// ׳׃ֵ?????ֹּ־ְֹ ׳Ù׳ֵֹּ, Þװֿ ֹּ //////////

