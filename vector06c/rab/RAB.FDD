MACLIB MATH
MACLIB GRAPH
MACLIB SOUND

ORG 100H
SAVE4CPM
CALL MAIN
QUIT2CPM
RST07
DS 0E7H
POINT
CHAR
BOLDCHAR
$INCLUDE(:C:HREN.ASM)
MAIN:
	TURBOCLS
	CALL OUTINFO
	DB 7,7,6,2,' TEST OUTINFO .'
	DB 13,13,6,1,12,10,'small symbols'
	DB 0
TESTCOL:
	CALL OUTINFO
	DB 13,7   ; SET COLOR COLR
COLR:	DB 0,'COLOR ',3 ;PUT NEXT BYTE IN HEX
HCOLR:	DB 0,0 ;QUIT FROM THIS
	LXI H,COLR
	INR M
	LXI H,HCOLR
	INR M
	MVI A,7
	ANA M
	JNZ TESTCOL

	LPAUSE
	BELL
	MVI H,6
	MVI L,200
	CALL PLOT
	BELL
	WAITKEY
	LPAUSE ;נןהןצהום, ‏פןגש ץףנופר ןפנץףפיפר
		;כלבקûץ
TESTPLOT:
	RND
	ANI 15 ;‏יףלן 0..15
	ADI 121
	MOV H,A ;כןןעה.X
	RND
	ANI 31
	ADI 200
	MOV L,A ;NEW Y
	RND
	ANI 7 ;דקופ 0..7
	CALL SETCOLOR ;ץףפבמןקים דקופ
	CALL PLOT ;קשקוהום מבכןמוד פן‏כץ
	LDA KEY   ; צהום מבצבפיס
	CPI SPACE ; כלבקיûי נעןגול
	JNZ TESTPLOT
	RET
	END ;כןמוד נעןחי מב קוכבףםו
AR2 EQU 0BH
ORG 100H
DI
LXI SP,8000H
LHLD 39H
SHLD OLD39H
XRA A
OUT 10H
LXI H,APINIT
SHLD 39H
EI
CALL PROGRM
DI
LHLD OLD39H
SHLD 39H
MVI A,23H
OUT 10H
EI
JMP 0
; MATH.INC 
LDIR:
	PUSH PSW
	MOV A,M
	STAX D
	INX H
	INX D
	DCX B
	MOV A,B
	ORA C
	JNZ LDIR+1
	POP PSW
RET

XDIR:
PUSH PSW
 MOV A,M
 PUSH PSW
  LDAX D
  MOV M,A
 POP PSW
 STAX D
 INX H
 INX D
 DCX B
 MOV A,B
 ORA C
 JNZ XDIR+1
POP PSW
RET

ADDHL:ADD L
MOV L,A
RNC
INR H
RET
SUBHB:MOV A,L
SUB C
MOV L,A
MOV A,H
SBB B
MOV H,A
RET
CMPHD:MOV A,H
CMP D
RNZ
MOV A,L
CMP E
RET

RND:
PUSH H
PUSH B
LXI H,MASRND
LDA pMASRND
MOV C,A
ADI 13
ANI 1FH
STA pMASRND
CALL ADDHL
MOV A,C
MOV C,M
LXI H,MASRND
CALL ADDHL
MOV A,M
ADD C
ACI 1
MOV M,A
POP B
POP H
RET
pMASRND:DB 0
MASRND:DS 20H

MULT:LXI H,0 ;AHL = DE*A
MVI B,8
MULT1:DAD H
RAL
JNC $+6
DAD D
ACI 0
DCR B
JNZ MULT1
RET
DIVAC:MVI B,255 ;A=A/C
INR B
SUB C
JNC $-2
ADD C
MOV C,A
MOV A,B
RET
MULTCD: ; BC=C*D
MVI B,0
MVI E,9
MCD0:MOV A,C
RAR
MOV C,A
DCR E
RZ
MOV A,B
JNC $+4
ADD D
RAR
MOV B,A
JMP MCD0
DIVBCA:  ; BC=BC/A(DE)
PUSH H
CMA
INR A
MOV E,A
MVI D,-1
LXI H,0
MVI A,17
DBCA0:PUSH H
DAD D
JNC $+4
XTHL
POP H
PUSH PSW
MOV A,C
RAL
MOV C,A
MOV A,B
RAL
MOV B,A
MOV A,L
RAL
MOV L,A
MOV A,H
RAL
MOV H,A
POP PSW
DCR A
JNZ DBCA0
;
ORA A
MOV A,H
RAR
MOV D,A
MOV A,L
RAR
MOV E,A
POP H
RET




; GRAPH.INC
;MACLIB MATH
;EXTRN CMPHD
TABLSYM EQU 1000H
POPA MACRO
     POP H
     POP D
     POP B
     ENDM
PUSHA MACRO
      PUSH B
      PUSH D
      PUSH H
      ENDM

PLOT:
PUSHA
MVI A,7
ANA H
LXI D,NumBit
ADD E
MOV E,A
JNC $+4
INR D
MOV A,H
RRC
RRC
RRC
ANI 1FH
ORI 80H
MOV H,A
MOV A,L
CMA
MOV L,A
LXI B,2000H
LDAX D
MOV D,A
NOP
ORA M
MOV M,A
REPT 2
	DAD B
	MOV A,D
	NOP
	ORA M
        MOV M,A
	ENDM
DAD B
MOV A,D
NOP
WHCOL:ORA M
NOP ;MOV M,A
POPA
RET

NumBit:DB 80H,40H,20H,10H,8,4,2,1

SETCOL: ;ץףפבמןקכב דקופב הלס ףגש PLOT
PUSH D
PUSH H
PUSH PSW
MVI D,3
LXI H,WHCOL
SETC0:
	RRC
	JNC SETC1
	MVI M,0B6H
	DCX H
	MVI M,0
	JMP SETC2
SETC1:  MVI M,0A6H
	DCX H
	MVI M,2FH  ; 'CMA'
SETC2:  
REPT 4
	DCX H
	ENDM
DCR D
JP SETC0
POP PSW
POP H
POP D
RET
; VERTICAL/HORIZONTAL LINE
VHLINE:
PUSHA
LXI B,0
MOV A,H
CMP D
JZ $+10
MVI B,1
JC $+5
MVI B,-1
MOV A,L
CMP E
JZ  $+10
MVI C,1
JC $+5
MVI C,-1
VHL0:CALL CMPHD
JZ VHL1
CALL PLOT
MOV A,H
ADD B
MOV H,A
MOV A,L
ADD C
MOV L,A
JMP VHL0
VHL1:POPA
RET
; ־ֱִָֹֽֿ ֳ׳ֵװ װֿÞֹֻ HL ׳ A
GETCOLOR:PUSHA
MOV A,L
CMA
MOV L,A
MVI A,7
ANA H
LXI D,NumBit
ADD E
MOV E,A
JNC $+4
INR D
MOV A,H
RRC
RRC
RRC
ANI 1FH
ORI 80H
MOV H,A
LDAX D
MOV C,A
LXI D,2000H
MOV B,E
ANA M
JZ $+4
STC
MOV A,B
RAL
MOV B,A
MOV A,C
DAD D
ANA M
JZ $+4
STC
MOV A,B
RAL
MOV B,A
MOV A,C
DAD D
ANA M
JZ $+4
CMC
MOV A,B
RAL
MOV B,A
MOV A,C
DAD D
ANA M
JZ $+4
STC
MOV A,B
RAL
POPA
RET

;///// קשקןה ףיםקןלב מב üכעבמ ק 4-ט נלןףכןףפסט //////
PUTUCHAR:
PUSHA
PUSH PSW
XCHG
MOV L,A
MVI H,0
DAD H
DAD H
DAD H
ADDRTBL:LXI B,TABLSYM
DAD B
XCHG
MVI A,80H
ORA H
MOV H,A
MOV A,L
ADD A
ADD A
ADD A
CMA
MOV L,A
MVI B,8
;
PUC1:LDA HEIGHT
MOV C,A  ;//////׳Ù׃ֿװֱ ׃ֹֽ׳ֱּֿ//////
PUC2:
REPT 3
  LDAX D
  NOP
  MOV M,A
  MVI A,20H
  ADD H
  MOV H,A
  ENDM
LDAX D
PCOL1:NOP ; ןגעבגןפכב (nop,xra a,cma)
NOP ;mov m,a
MVI A,0A0H
ADD H
MOV H,A
DCR L
DCR C
JNZ PUC2
INX D
DCR B
JNZ PUC1
POP PSW
POPA
RET
;/////// ױ׃װֱ־ֿ׳ֱֻ ֳ׳ֵװֱ ִּׁ ׃ֹֽ׳ּֿֿ׳,׳Ù׳ִֹֽֿÙָ PUTUCHAR ///
;
CHARCOLOR:
PUSH B
PUSH H
MOV B,A
MVI C,0
ANI 10H
JZ $+5
MVI C,2FH   ;'CMA'
MOV A,B
MVI B,3
LXI H,PCOL1
CHC1:RRC
MOV M,C
JC $+5
MVI M,0AFH
REPT 7
	DCX H
	ENDM
DCR B
JP CHC1
POP H
POP B
RET
HEIGHT: DB 1
CURSOR:DW 0

;////// קשקןה ימזן ב היףנלוך //////////////
OUTINFO:POP H
MOV A,M
INX H
ORA A 
JZ INFEND
CPI 1
JZ SETCURS
CPI 2
JZ PUTBYTE
CPI 3
JZ cINVERS
CPI 4
JZ cNORM
CPI 5
JZ PUTWORD
CPI 6
JZ chHEIGHT ; ֵֽ־ֵֽׁ ׳Ù׃ֿװױ ׳Ù׳ִֹֽֿÙָ ׃ֹֽ׳ּֿֿ׳
CPI 7
JZ chCOLOR  ;ֵֽ־ֵֽׁ ֳ׳ֵװ ׳Ù׳ִֹֽֿÙָ׃ֹֽ׳ּֿֿ׳
CPI 13
JZ CRLF
;////// ימב‏ו נעןףפן קשקןהים ףיםקןל /////////
PUSH H
LHLD CURSOR
CALL PUTUCHAR
LXI H,CURSOR+1
INR M
POP H
JMP OUTINFO+1
INFEND:PCHL
SETCURS:MOV A,M
STA CURSOR
INX H
MOV A,M
STA CURSOR+1
INX H
JMP OUTINFO+1
cINVERS:MVI A,16H
CALL CHARCOLOR
JMP OUTINFO+1
cNORM:MVI A,6
CALL CHARCOLOR
JMP OUTINFO+1
chHEIGHT:MOV A,M
STA HEIGHT
INX H
JMP OUTINFO+1
chCOLOR:MOV A,M
CALL CHARCOLOR
INX H
JMP OUTINFO+1
CRLF:PUSH H
LHLD CURSOR
MVI H,0
INR L
SHLD CURSOR
POP H
JMP OUTINFO+1
;//////// ׳Ù׳ִֿ ׃ּֿ׳ֱ ׳ 10-װֹÞ־ֿÊ ׃ֹ׃װֵֵֽ /////////
PUTWORD:
MOV E,M
INX H
MOV D,M
INX H
PUSH H
XCHG
CALL SETCIF
POP H
JMP OUTINFO+1
SETCIF:LXI B,-10000
CALL PUTCIF
LXI B,-1000
CALL PUTCIF
sBYTE:
LXI B,-100
CALL PUTCIF
LXI B,-10
CALL PUTCIF
MOV A,L
JMP OUTC2
PUTCIF:MVI E,255
INR E
DAD B
JC $-2
MOV A,L
SUB C
MOV L,A
MOV A,H
SBB B
MOV H,A
MOV A,E
OUTC2:ADI 30H
PUSH H
LHLD CURSOR
CALL PUTUCHAR
LXI H,CURSOR+1
INR M
POP H
RET
PUTBYTE:MOV A,M
INX H
PUSH H
MOV L,A
MVI H,0
CALL sBYTE
POP H
JMP OUTINFO+1



; BITMAP.INC
;
PUTPCHAR:
PUSHA
PUSH H
MOV L,A
MVI H,0
DAD H
DAD H
DAD H
LXI D,TABLSYM
DAD D
XCHG
MVI A,8
POP H
PUTPC1:PUSH PSW
PUSH B
PUSH H
PUSH B
LDAX D
MVI C,8
PUTPC12:PUSH  B
RLC
PUSH PSW
LDA SYMCOLOR
JC $+6
LDA BACKCOLOR
CALL SETCOL
CALL PLOT
INR  H
DCR B
JNZ $-5
POP PSW
POP B
DCR C
JNZ PUTPC12
POP B
POP H
INR L
DCR C
JNZ PUTPC1+2
POP B
INX D
POP PSW
DCR A
JNZ PUTPC1
POPA
RET

PUTpSTRING:
LDAX D
ORA A
INX  D
RZ
CALL PUTPCHAR
MOV A,B
ADD A
ADD A
ADD A
ADD H
MOV H,A
JMP PUTpSTRING
SYMCOLOR:DB 0
BACKCOLOR:DB 0

GET:PUSH B
PUSH H
PUSH  PSW
GET1:PUSH B
PUSH H
CALL GETCOLOR
RAL
RAL
RAL
RAL
ANI 0F0H
STAX D
DCR C
JZ GET2
INR H
CALL GETCOLOR
XCHG
ORA M
MOV M,A
XCHG
INX D
INR H
DCR C
JNZ GET1+2
DCX D
GET2:INX D
POP H
INR L
POP B
DCR B
JNZ GET1
POP PSW
POP H
POP B
RET
PUT:
PUSHA
PUSH PSW
PUT1:PUSH H
PUSH B
LDAX D
RRC
RRC
RRC
RRC
CALL SETCOL
CALL PLOT
DCR C
JZ PUT2
INR H
LDAX D
CALL SETCOL
CALL PLOT
INR H
INX D
DCR C
JNZ PUT1+2
DCX D
PUT2:INX D
POP B
POP H
INR L
DCR B
JNZ PUT1
POP PSW
POPA
RET









KEYS:DB 0FEH,0FDH,0FBH,0F7H,0EFH,0BFH,0DFH,7FH
KEY:DB 0
SCROLL:DB 0FFH
BORDER:DB 0
OLD39H:DW 0
APINIT:PUSH H
PUSH D
PUSH B
PUSH PSW
LXI H,PEREP
XRA A
CMP M
JZ INIT2
DCR M
LXI D,100FH
LXI H,COLR15
INIT1:MOV A,E
OUT 2
MOV A,M
OUT 0CH
OUT 0CH
NOP

NOP
DCX H
OUT 0CH
DCR E
DCR D
OUT 0CH
JNZ INIT1
INIT2:MVI A,8AH
OUT 0
LXI H,KEYS
MVI A,0FEH
INIT3:PUSH PSW
OUT 3

IN 2
MOV M,A
POP PSW
INX H
RLC
JC INIT3
CALL GETCODE
MVI A,88H
OUT 0
LDA SCROLL
OUT 3
LDA BORDER
OUT 2
POP PSW
POP B
POP D
POP H
EI 
RET
; 
; פבגלידב דקופןק הלס 2-ט נלןףכןףפוך
; יףנןלרתץוםשטק הןףו :
; III-A000-BFFF, II-C000-DFFF

COLR0:DB 0,0,0E8H,0E8H,2BH,2BH,0ADH,0ADH
DB 0,0,0E8H,0E8H,2BH,2BH,0ADH
COLR15:DB 0ADH

PEREP:DB 50

GETCODE:
XRA A
STA KEY
MVI C,0
SETCOD:MVI B,8
LXI H,KEYS
SETCO:MOV A,M
CPI 0FFH
JNZ YKLAV
MOV A,C
ADI 8
MOV C,A
DCR B
INX H
JNZ SETCO
RET
YKLAV:RAR
INR C
JC YKLAV
MOV A,C
STA KEY
RET


;CLS FOR CP/M
CLS:LXI H,0A000H
LXI D,0C000H
LXI B,20FFH
XRA A
CLS1:MOV M,A
STAX D
INX H
INX D
DCX B
CMP B
JNZ CLS1
RET
;
PROGRM:
CALL CLS
LXI H,0
LXI B,0305H
MVI A,6
STA SYMCOLOR
MVI A,2
STA BACKCOLOR
MVI A,8
CALL PUTPCHAR
LXI H,0
LXI B,2818H
LXI D,7000H
CALL GET
XCHG
SHLD ADDR

CALL OUTINFO
DB 7,6,1,0,5,'ADDR=',5
ADDR:DW 0
DB 0
TST1:
MVI C,10
HLT
DCR C
JNZ $-2
CALL RND
LDA KEY

ORA A
JZ $-7
CPI AR2
RZ
CALL RND
MOV H,A
CALL RND
MOV L,A
LXI D,7000H
LXI B,2818H
CALL PUT
JMP TST1


END

